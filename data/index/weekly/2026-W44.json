nk":"https://mp.weixin.qq.com/s?__biz=MjM5MDE0Mjc4MA==&mid=2651296315&idx=1&sn=ba792a45e31c45a6801235227c54d131","date":"2026-10-31 13:54:00","archive_path":"data/articles/2026/10/RAW_089809fb46.json","topicTag":"ai-llm","category":"Programming_Technology","sourceName":"InfoQ 中文","resourceType":"ARTICLE","readTime":69,"score":90},{"id":"RAW_8e4380aa3d","title":"微软那栋据传闹鬼的大楼","link":"https://devblogs.microsoft.com/oldnewthing/20261030-00/?p=112815/","date":"2026-10-31 13:08:02","topicTag":"other","category":"Programming_Technology","sourceName":"The Old New Thing","resourceType":"ARTICLE","readTime":3,"score":78},{"id":"RAW_d5cf860bb9","title":"阿里巴巴与 Apple 达成合作，将千问集成至 Apple 智能","link":"https://mp.weixin.qq.com/s?__biz=Mzg4NTczNzg2OA==&mid=2247512318&idx=1&sn=9969e18a672d01b5c803a20991f2846e","date":"2026-10-31 13:01:00","topicTag":"ai-llm","category":"Programming_Technology","sourceName":"阿里技术","resourceType":"ARTICLE","readTime":3,"score":88},{"id":"RAW_8a0b0b3edc","title":"Cloudflare 私有源站服务正式全面可用","link":"https://blog.cloudflare.com/private-origins-public-to-private/","date":"2026-10-30 22:23:43","archive_path":"data/articles/2026/10/RAW_8a0b0b3edc.json","topicTag":"devops","category":"Programming_Technology","sourceName":"The Cloudflare Blog","resourceType":"ARTICLE","readTime":9,"score":89},{"id":"RAW_23880a2dce","title":"如何利用知识图谱检测金融欺诈模式：生产环境实践指南","link":"https://www.freecodecamp.org/news/how-to-detect-financial-fraud-patterns-with-knowledge-graphs-a-production-guide/","date":"2026-10-30 21:57:52","archive_path":"data/articles/2026/10/RAW_23880a2dce.json","topicTag":"other","category":"Programming_Technology","sourceName":"freeCodeCamp","resourceType":"ARTICLE","readTime":16,"score":92},{"id":"RAW_935592f1e9","title":"DoorDash 借助 AI 智能体将杂货复购延迟从 16 秒降至 2 秒","link":"https://www.infoq.com/news/2026/10/doordash-ai-grocery-reorder/","date":"2026-10-30 21:31:00","archive_path":"data/articles/2026/10/RAW_935592f1e9.json","topicTag":"ai-llm","category":"Programming_Technology","sourceName":"InfoQ","resourceType":"ARTICLE","readTime":2,"score":87},{"id":"RAW_543ef496c5","title":"Netflix 将 GPU 可靠性视为分布式系统问题","link":"https://www.infoq.com/news/2026/10/netflix-gpu-distributed-systems/","date":"2026-10-30 20:00:00","archive_path":"data/articles/2026/10/RAW_543ef496c5.json","topicTag":"ai-llm","category":"Programming_Technology","sourceName":"InfoQ","resourceType":"ARTICLE","readTime":3,"score":87},{"id":"RAW_4b24919352","title":"以电商客服为例，看 AgentKit 技能评测如何让 Skill 敢上生产！","link":"https://mp.weixin.qq.com/s?__biz=MzI1MzYzMjE0MQ==&mid=2247523892&idx=1&sn=f210923b89308ffa03e248ab36043d7b","date":"2026-10-30 16:53:00","archive_path":"data/articles/2026/10/RAW_4b24919352.json","topicTag":"ai-llm","category":"Programming_Technology","sourceName":"字节跳动技术团队","resourceType":"ARTICLE","readTime":10,"score":92},{"id":"RAW_2da4c9cb1a","title":"同一个模型从 30 分到 95 分：拉开差距的不是模型，是 Harness","link":"https://mp.weixin.qq.com/s?__biz=MjM5MDE0Mjc4MA==&mid=2651296220&idx=2&sn=9511a71511181feae27668ca4818886b","date":"2026-10-30 15:34:00","archive_path":"data/articles/2026/10/RAW_2da4c9cb1a.json","topicTag":"ai-llm","category":"Programming_Technology","sourceName":"InfoQ 中文","resourceType":"ARTICLE","readTime":42,"score":90},{"id":"RAW_68ff36057b","title":"19 岁实习生如何为这家估值 20 亿美元的 AI 公司打造增长引擎 | Hector Serrano","link":"https://www.lennysnewsletter.com/p/how-a-19-year-old-intern-built-the","date":"2026-11-01 21:31:36","archive_path":"data/articles/2026/11/RAW_68ff36057b.json","topicTag":"ai-llm","category":"Product_Development","sourceName":"Lenny's Newsletter","resourceType":"ARTICLE","readTime":2,"score":84},{"id":"RAW_99df5b2d9a","title":"版面的美感，来自哪？","link":"https://mp.weixin.qq.com/s?__biz=MzA4NTk3NzUzOA==&mid=2247616146&idx=1&sn=e59f12f1de647abc809063c05678d623","date":"2026-11-01 16:21:00","topicTag":"other","category":"Product_Development","sourceName":"辛未设计","resourceType":"ARTICLE","readTime":13,"score":89},{"id":"RAW_77682465e","title":"软件开发走向智能体化后，如何判断质量？Emily Bache 与 Sam Newman 对谈","link":"https://www.youtube.com/watch?v=2QiguGJo1s4","date":"2026-10-31 03:00:09","oneSentenceSummary":"Emily Bache 与 Sam Newman 认为，智能体开发改变了质量验证方式，也让明确表达工程经验变得更重要。","summary":"Emily Bache 与 Sam Newman 区分用户体验到的外部质量，以及可运维性、代码工作体验等内部质量。领域语言、基于示例的规格和验收测试，可以帮助人与智能体对齐意图。两人对 TDD 的分歧保持克制：智能体正在接管内部实现循环，但精心设置的重构与测试仍可能保护底层设计。团队案例强调小变更和明确门槛，提到的 500 行阈值被明确标为不确定举例。他们提醒，长篇规格可能重演瀑布式开发，大量生成测试也不代表测试有价值。探索式测试部分含 BearQ 赞助，同时追问缺少经验的人如何判断工具效果。放射科类比说明，增强专家判断与替代专家会带来不同结果。自动化应释放工程师和测试人员的时间，用于更难的风险，尤其是产品开始包含非确定性 AI 时。","archive_path":"data/articles/2026/10/RAW_77682465e.json","topicTag":"ai-llm","category":"Programming_Technology","sourceName":"Modern Software Engineering","resourceType":"VIDEO","readTime":16,"score":90},{"id":"RAW_cecb2ae21","title":"与 Titus Winters 谈 Google 软件工程经验与 CS 教育改革","link":"https://www.youtube.com/watch?v=mQu0zN4IvSI","date":"2026-10-29 02:41:17","topicTag":"ai-llm","category":"Programming_Technology","sourceName":"The Pragmatic Engineer","resourceType":"VIDEO","readTime":75,"score":92},{"id":"RAW_8226199a5","title":"什么时候自托管 AI 模型比购买 API 更划算：imec 的任务级基准研究","link":"https://www.youtube.com/watch?v=9-Y_oS9OBLc","date":"2026-10-31 16:00:24","oneSentenceSummary":"Steven Latré 指出，自托管 AI 的经济性取决于任务准确率、硬件匹配、并发、GPU 利用率与 harness 效率，不能只比较 token 价格。","summary":"Steven Latré 介绍 imec 的基准研究，讨论企业何时应从模型 API 转向租用或自建 GPU 基础设施。团队围绕长周期编程任务，测试多种模型与 harness，通过千余次运行比较任务完成情况、延迟和基础设施成本。准确率相近的模型可能需要截然不同的 GPU 配置，更强模型带来的硬件成本变化也并非线性。并发是另一项约束：模型权重与各用户的 KV cache 共同占用内存，某个较大模型配置仅能支持约四名用户舒适并发，速度仍慢于 API 基线。讲者报告，不同配置的盈亏平衡利用率差异很大，较低档配置约需 89%，八张 B200 的系统则约需 15%。harness 即使带来相似准确率，也可能产生不同 token 数和 GPU 占用时长；某个使用 Codex 的 GLM 配置消耗约少一半 token。讲者强调结果仅针对特定编程工作负载，模型和硬件持续变化，企业混合任务还会增加复杂性。部分字幕数字和模型名含糊，因此更应参考其评估框架，而非套用统一节省比例。","topicTag":"ai-llm","category":"Artificial_Intelligence","sourceName":"AI Engineer","resourceType":"VIDEO","readTime":14,"score":90},{"id":"RAW_c8a9f30f1","title":"问错一句就可能违规：Upstart 与 Coval 的语音 AI 评估闭环","link":"https://www.youtube.com/watch?v=3osCbSufv8g","date":"2026-10-31 15:00:11","oneSentenceSummary":"Upstart 与 Coval 介绍如何通过人工监督的评估闭环，对齐判官、复核失败并在上线前模拟修复，让受监管场景中的语音智能体更可靠。","summary":"Shiv Indap 与 Brooke Hopkins 介绍 Upstart 如何评估处理贷款核验电话的语音智能体。流程需要验证身份、提出少量问题，并遵守依赖上下文的限制，例如不能追问医疗用途的金额。依靠表格逐通人工审核难以维护，因此团队与 Coval 建立结构化复核流程。合规判断要与领域专家对照，反馈既能发现未写入系统的规则和审核者之间的分歧，也能暴露 LLM 判官的问题。讲者报告，人机判断一致率从 33% 提升至 92%；这衡量的是与人工判断的对齐程度，并不保证贷款通话零错误。完整闭环包括定义产品指标、评分线上通话、发现已知与未知失败、分派责任团队，再通过语音对语音模拟测试噪声、口音和打断等条件下的修复。自我改进仍受人工复核和功能开关约束，不同改动需要工程或合规批准。分享提供具体运营方法，但未给出样本量、独立验证和完整实验控制。","topicTag":"ai-llm","category":"Artificial_Intelligence","sourceName":"AI Engineer","resourceType":"VIDEO","readTime":12,"score":90},{"id":"RAW_362c12f08","title":"每次会话都像新员工入职：Sonar Vortex 如何为 AI 编程补充上下文与验证","link":"https://www.youtube.com/watch?v=8vDzncmzxyg","date":"2026-10-31 03:00:14","oneSentenceSummary":"Sonar Vortex 将仓库上下文与确定性检查接入编程智能体循环，在代码进入 PR 前发现缺陷。","summary":"Sonar 的 Killian 指出，编程智能体缺少项目约定时，会反复搜索仓库，也可能复制已有缺陷。Sonar Vortex 在实施前提供仓库关系、架构指引、批准使用的库和编码规则，编辑后执行确定性检查，结束前再做跨文件数据流分析。录制演示让智能体复用临时日志文件并补测试，但测试未发现权限问题；第一次修复依赖平台默认权限，复检要求显式设置后才继续修正。讲者引用逾 1，100 名开发者的调查，称 96% 并不完全信任 AI 代码，48% 会完整验证；还宣称 token 减少 36%、生产故障减少 44%，但未给研究方法。可借鉴的是把上下文和独立验证前移，并将确定性分析与 AI 审查结合。","topicTag":"ai-llm","category":"Artificial_Intelligence","sourceName":"AI Engineer","resourceType":"VIDEO","readTime":12,"score":90},{"id":"RAW_7dd101115","title":"研究权力 50 年后，Robert Caro 得到了哪些认识","link":"https://www.youtube.com/watch?v=f0J_EeW42Lo","date":"2026-10-31 01:18:35","oneSentenceSummary":"Robert Caro 解释权力如何促成公共成就，又如何使掌权者变得冷酷，并分享持续采访、阅读档案和确立核心命题的传记写作方法。","summary":"Robert Caro 结合数十年研究 Robert Moses 和 Lyndon Johnson 的经历，区分完成公共目标的能力与意志不受约束造成的伤害。他反对将 Moses 简化为纯粹的破坏者：年轻时的改革者曾让公众更容易抵达公园和海滩，却逐渐把反对者和遭驱逐的居民视为障碍。对于今天是否需要另一个 Moses，他希望恢复建设能力，但不赞同同样的冷酷，也没有给出平衡二者的简单制度方案。\n\nCaro 回忆，随着 Moses 失去权力，办公室电话不再响起，成了鲜明的现场信号。他解释，公众支持和交错任期曾使撤换 Moses 在政治和制度层面都很困难，即便名义上存在相应权力。谈到 Johnson，他认为说服力背后是委员会席位、立法和政治资源的实际杠杆。他肯定 Johnson 的国内改革抱负，同时承认越战悲剧，并明确表示尚未想清升级战争的根本原因。\n\n访谈也展示了传记研究的工作方式：坚持访问不可替代的证人，用档案细节提出具体问题，并在动笔前把全书目的压缩成一句话。数字档案能加快寻找材料，但寻找只是阅读工作的一小部分。他还谈到艰难删稿、保留采访笔记供后世研究，以及选择便于访问的纽约档案馆。最后，边疆生活的孤独与他本人长期写作所需的隔离和专注相互映照。历史评价和回忆均保留 Caro 的归属，赞助内容不作为访谈论据。","topicTag":"other","category":"Artificial_Intelligence","sourceName":"Dwarkesh Patel","resourceType":"VIDEO","readTime":32,"score":92},{"id":"RAW_5c3d1e3b7","title":"智能体为什么白花钱：x402 支付的 6 种攻击与防护 | Ishween Kaur，SoFi","link":"https://www.youtube.com/watch?v=YU1uD_YkpjU","date":"2026-10-30 17:00:31","oneSentenceSummary":"六组 x402 攻击实验说明，智能体花钱前需要明确的支付限制、防重放机制、卖家校验与端到端追踪。","summary":"Ishween Kaur 从 20 种 x402 智能体支付攻击实验中，展开六种典型失败。价格操纵利用卖家标价与支付请求头之间的差异，因此必须核对金额、钱包与网络。重复使用同一支付编号可能多次通过签名验证，却只有一次真正结算；共享状态与幂等重试分别保护卖家免于重复交付、买家免于重复扣款。结算前放行数据需要权衡延迟与损失，未受保护的接口和公共缓存也可能绕过付费墙。跨页面重放则需要把支付凭证绑定到实际交付资源。仿冒卖家要求持续维护批准名单与观察名单。提示注入实验中，卖家回复诱导智能体购买高级摘要，使 5 美分请求变成 55 美分；限定本轮只执行一次购买后，该次攻击被拦截。上线建议是从单个支付 ID 贯穿全链路追踪，再建立小型成功与失败样本集，经过影子评估后逐步强制防护。这些是测试环境中的演示与设计建议，不能直接证明所有生产实现都有相同漏洞。","topicTag":"ai-llm","category":"Artificial_Intelligence","sourceName":"AI Engineer","resourceType":"VIDEO","readTime":12,"score":90},{"id":"RAW_94620ef5f","title":"挑战 ServiceNow：Serval CEO Jake Stauch 谈企业编程智能体与权限治理","link":"https://www.youtube.com/watch?v=EZcWEsMuLb4","date":"2026-10-29 18:00:20","oneSentenceSummary":"Serval CEO Jake Stauch 认为，企业编程智能体需要确定性审批、受控提权与软件开发规范，才能安全地让 IT 团队和业务人员成为构建者。","summary":"Jake Stauch 将 Serval 定位为直接挑战 ServiceNow 的企业自动化和服务管理平台。他认为代码适合表达灵活的工作流，而传统流程构建器对技术和非技术用户都可能显得别扭。更强的编程智能体，让 IT、人力、财务等团队也能创建代码自动化，但审批和治理体系依然不可或缺。\n\n他区分企业自动化与只拥有员工个人权限的助理。Serval 可以连接管理员服务账号，同时要求访问申请、确定性审批、审计记录，以及针对特定工作流的即时授权。他预计，智能体放大过度授权带来的风险后，个人权限会进一步收紧。因此模型能力增强，反而可能增加企业对边界控制的需求。\n\n落地需要了解已有流程，并由部署策略人员、软件工程师与 ProServal 团队持续支持自动化。开发、预发、评审和验收测试，是企业采用的基本要求。管理智能体 Catalyst 把用户需求转换为自动化、策略与平台原语；客户反复创建的同类模式，也可能成为正式产品功能。\n\n在商业层面，Stauch 倾向按工作流运行次数收费，并承认如何证明 token 支出的价值仍是难题。他预测小型 SaaS 工具会被整合，而核心业务记录系统不会消失。后台智能体的自治问题仍未解决：逐步批准确定性工具可以扩大能力，但不受限制的代码执行风险很高。结尾介绍了工程师深入客户、偏重产品判断与分散决策的组织方式。客户认可、增长和产品效果均为创始人自述，并不能独立证明系统安全或商业模式必然成功。","topicTag":"ai-llm","category":"Artificial_Intelligence","sourceName":"No Priors","resourceType":"VIDEO","readTime":36,"score":90}]
