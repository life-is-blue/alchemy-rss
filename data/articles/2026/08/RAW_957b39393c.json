  "content": "<!-- Start of bodyStart -->\n<!-- End of bodyStart -->\n<html>\n <head></head>\n <body>\n  <div id=\"main\" data-framer-hydrate-v2=\"{&quot;routeId&quot;:&quot;gMTbbxJsi&quot;,&quot;localeId&quot;:&quot;default&quot;,&quot;pathVariables&quot;:{&quot;tC6ll62vk&quot;:&quot;actinide-becomes-first-startup-to-ever-enrich-natural-uranium-to-produce-haleu&quot;},&quot;breakpoints&quot;:[{&quot;hash&quot;:&quot;1haos8f&quot;,&quot;mediaQuery&quot;:&quot;(min-width: 1200px)&quot;},{&quot;hash&quot;:&quot;uyvlv0&quot;,&quot;mediaQuery&quot;:&quot;(min-width: 810px) and (max-width: 1199.98px)&quot;},{&quot;hash&quot;:&quot;19awain&quot;,&quot;mediaQuery&quot;:&quot;(max-width: 809.98px)&quot;},{&quot;hash&quot;:&quot;ojn2j8&quot;,&quot;mediaQuery&quot;:&quot;(min-width: 1200px)&quot;},{&quot;hash&quot;:&quot;pr669c&quot;,&quot;mediaQuery&quot;:&quot;(min-width: 810px) and (max-width: 1199.98px)&quot;},{&quot;hash&quot;:&quot;1yhzwnn&quot;,&quot;mediaQuery&quot;:&quot;(max-width: 809.98px)&quot;}],&quot;collectionItemId&quot;:&quot;hBlCUGpGg&quot;}\" data-framer-ssr-released-at=\"2026-08-25T15:58:25.564Z\" data-framer-page-optimized-at=\"2026-08-26T20:41:36.942Z\" data-framer-generated-page>\n   <!--$-->\n   <div class=\"framer-UdAVR framer-ojn2j8\" data-layout-template=\"true\" style=\"min-height:100vh;width:auto\">\n    <div class=\"framer-12982y8-container\" data-framer-name=\"Site Navigation\" name=\"Site Navigation\">\n     <div class=\"ssr-variant hidden-1yhzwnn hidden-pr669c\">\n      <div name=\"Site Navigation\" class=\"framer-6Foqz framer-m7W1i framer-6rG2c framer-ak441a framer-v-ak441a\" data-framer-name=\"Desktop\" style=\"background-color:rgba(0, 0, 0, 0);width:100%;will-change:transform;opacity:1;transform:none\">\n       <div class=\"framer-xlruxi\" data-framer-name=\"Top\" style=\"background-color:rgba(0, 0, 0, 0)\">\n        <div class=\"framer-1umjqdy\" data-framer-name=\"Logo Container\">\n         <div class=\"framer-ktyvoi\">\n          <div c