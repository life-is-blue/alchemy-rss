an><span class=\"token operator\">:</span><span class=\"token plain\"> </span><span class=\"token string\">'app'</span><span class=\"token plain\"> </span><span class=\"token punctuation\">}</span><span class=\"token punctuation\">,</span><span class=\"token plain\"></span></div></div><div class=\"line\" data-geist-code-block-line=\"true\" id=\"C19cb2302-L5\" style=\"font-feature-settings:&quot;liga&quot; off\"><div class=\"token-line\"><span class=\"token plain\">  scopes</span><span class=\"token operator\">:</span><span class=\"token plain\"> </span><span class=\"token punctuation\">[</span><span class=\"token string\">'write_products'</span><span class=\"token punctuation\">]</span><span class=\"token punctuation\">,</span><span class=\"token plain\"></span></div></div><div class=\"line\" data-geist-code-block-line=\"true\" id=\"C19cb2302-L6\" style=\"font-feature-settings:&quot;liga&quot; off\"><div class=\"token-line\"><span class=\"token plain\"></span><span class=\"token punctuation\">}</span><span class=\"token punctuation\">)</span><span class=\"token punctuation\">;</span><span class=\"token plain\"></span></div></div><div class=\"line\" data-geist-code-block-line=\"true\" id=\"C19cb2302-L7\" style=\"font-feature-settings:&quot;liga&quot; off\"><div class=\"token-line\"><span class=\"token plain\" style=\"display:inline-block\">\n</span></div></div><div class=\"line\" data-geist-code-block-line=\"true\" id=\"C19cb2302-L8\" style=\"font-feature-settings:&quot;liga&quot; off\"><div class=\"token-line\"><span class=\"token plain\"></span><span class=\"token keyword\">await</span><span class=\"token plain\"> </span><span class=\"token function\">fetch</span><span class=\"token punctuation\">(</span><span class=\"token template-string template-punctuation string\">`</span><span class=\"token template-string string\">https://acme.myshopify.com/admin/api/2026-01/graphql.json</span><span class=\"token template-string template-punctuation string\">`</span><span cl