px) 1728px, 100vw\" srcset=\"https://media.bestblogs.dev/20261123222459_shirudo-partner-logos-landscape-2x.png 640w, https://media.bestblogs.dev/20261123222459_shirudo-partner-logos-landscape-2x.png 750w, https://media.bestblogs.dev/20261123222458_shirudo-partner-logos-landscape-2x.png 828w, https://media.bestblogs.dev/20261123222459_shirudo-partner-logos-landscape-2x.png 1080w, https://media.bestblogs.dev/20261123222458_shirudo-partner-logos-landscape-2x.png 1200w, https://media.bestblogs.dev/20261123222459_shirudo-partner-logos-landscape-2x.png 1920w, https://media.bestblogs.dev/20261123222459_shirudo-partner-logos-landscape-2x.png 2048w, https://media.bestblogs.dev/20261123222459_shirudo-partner-logos-landscape-2x.png 3840w\" src=\"https://media.bestblogs.dev/20261123222459_shirudo-partner-logos-landscape-2x.png\"></picture>\n          </div>\n         </div>\n        </div>\n        <div class=\"relative mt-3 w-full\">\n         <div class=\"flex w-full items-end justify-between text-center\">\n          <div class=\"grow\">\n           <div class=\"text-copy-secondary text-caption text-pretty line-clamp-2\"></div>\n          </div>\n         </div>\n        </div>\n       </div>\n      </div>\n     </div>\n    </div>\n   </div>\n   <div class=\"w-full toc-visible:md:grid-cols-10 gap-x-(--grid-gap) [--grid-gap:8px] md:[--grid-gap:16px] lg:[--grid-gap:24px]\">\n    <div data-show-toc=\"true\" class=\"col-span-full w-full min-w-0 md:col-span-10 md:col-start-3\">\n     <div class=\"toc-visible:md:grid-cols-10 gap-x-(--grid-gap) [--grid-gap:8px] md:[--grid-gap:16px] lg:[--grid-gap:24px] article-actions-spacing pt-20 w-full\">\n      <div data-article-hero-actions=\"true\" data-article-hero-copy-region=\"support\" class=\"col-span-full toc-visible:@md:col-start-2 flex w-full flex-wrap items-start justify-between gap-x-6 gap-y-3 border-t border-t-primary-4 pt-3\">\n       <div class=\"w-fit max-w-full min-w-0 flex-col\" data-read-aloud-ui=\"true\">\n        <div class=\"min-h-10 items-center\">\n         <div class=\"relative flex\">\n          <div class=\"flex items-center\">\n           <button type=\"button\" class=\"ease-curve-a disabled:text-gray-40 items-center justify-center outline-offset-2 duration-200 focus-visible:outline focus-visible:outline-offset-0 flex rounded-full transition size-8 bg-primary-4 focus:outline-primary-12 text-primary-100 hover:bg-primary-12 backdrop-blur-[4.375rem] p-6xs relative shrink-0 grow-0\" aria-label=\"Play audio of page text\"> \n            <svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\">\n             <use href=\"/icons/cms/27bb77900ed6df73/play-sm-fill.svg#size-16\" width=\"16\" height=\"16\"></use>\n            </svg> \n           </button><span class=\"shrink grow ps-3 text-cta\"><span class=\"flex items-center gap-3\"><span>Listen to article</span><span class=\"border-s border-s-primary-4 py-1 ps-3 tabular-nums\">5:08</span></span></span>\n          </div>\n         </div>\n        </div>\n        <audio preload=\"none\"></audio>\n       </div>\n       <div class=\"flex gap-4 ms-auto\">\n        <div class=\"relative\">\n         <div class=\"flex items-center gap-1\" type=\"button\" aria-haspopup=\"dialog\" aria-expanded=\"false\" data-state=\"closed\">\n          <span class=\"text-cta\"><button type=\"button\" class=\"transition duration-short ease-curve-a rounded-[2.5rem] text-nowrap min-h-8 flex items-center justify-center gap-[0.3em] text-cta focus:outline outline-offset-2 h-[2.5rem] text-primary-100 hover:text-primary-60 disabled:text-primary-44 focus:outline-none focus-visible:outline-primary-44 px-0 !rounded\"> \n            <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"17\" fill=\"none\" viewBox=\"0 0 20 20\">\n             <path fill=\"currentColor\" d=\"M4.52 7.62a.875.875 0 0 1 1.244 1.232L4.67 9.957l-.003.003c-1.384 1.385-1.421 3.658.147 5.227 1.568 1.568 3.842 1.531 5.227.147l.002-.002 1.107-1.095a.875.875 0 0 1 1.231 1.243l-1.106 1.096c-2.105 2.1-5.485 2.062-7.698-.152s-2.251-5.592-.15-7.697z\" style=\"fill-opacity:1\"></path><path fill=\"currentColor\" d=\"M11.881 6.881A.876.876 0 0 1 13.12 8.12l-5 5a.876.876 0 0 1-1.24-1.24z\" style=\"fill-opacity:1\"></path><path fill=\"currentColor\" d=\"M8.726 3.425c2.105-2.1 5.485-2.063 7.698.15s2.252 5.594.15 7.699L15.48 12.38a.875.875 0 0 1-1.244-1.231l1.095-1.107.003-.002c1.384-1.385 1.421-3.659-.147-5.227s-3.842-1.53-5.227-.147l-.003.003-1.106 1.095a.876.876 0 0 1-1.23-1.244z\" style=\"fill-opacity:1\"></path>\n            </svg>Share \n           </button></span>\n         </div>\n        </div>\n       </div>\n      </div>\n     </div>\n    </div>\n   </div>\n  </div>\n  <div class=\"w-full toc-visible:md:grid-cols-10 gap-x-(--grid-gap) [--grid-gap:8px] md:[--grid-gap:16px] lg:[--grid-gap:24px]\">\n   <nav aria-label=\"Table of contents\" data-show-toc=\"true\" class=\"sticky top-header-h z-50 col-span-full -mx-6 h-0 w-[calc(100%+2*(--spacing(6)))] -translate-y-px transition duration-medium md:hidden opacity-0\" inert>\n    <div class=\"relative mx-auto w-(--document-width) border-b border-primary-4 bg-secondary-100\">\n     <div class=\"force-show-scrollbars relative mx-auto w-full overflow-auto xl:max-w-container-desktop\">\n      <button type=\"button\" aria-expanded=\"false\" class=\"flex h-toc-button-h w-full px-6 focus-visible:outline focus-visible:outline-offset-0 focus-visible:outline-primary-100\"><span class=\"truncate pe-5 text-xs leading-tight text-primary-100\">How Shirudo works</span></button><button inert type=\"button\" aria-label=\"Close table of contents\" class=\"absolute inset-e-6 -top-px z-10 focus-visible:outline focus-visible:outline-primary-100 pointer-events-none\"></button>\n     </div>\n    </div>\n   </nav>\n   <div data-toc-content=\"\" class=\"w-full toc-visible:md:grid-cols-10 gap-x-(--grid-gap) [--grid-gap:8px] md:[--grid-gap:16px] lg:[--grid-gap:24px] in-data-article-contained:flex in-data-article-contained:flex-col col-span-full min-w-0 md:row-start-1\">\n    <div class=\"col-span-full toc-visible:@md:col-start-2 max-w-none min-w-0 in-[:where(li)]:contents not-first:mt-6\">\n     <p class=\"mb-(--prose-body-margin-bottom,--spacing(6)) last:mb-0\"><span>OpenAI and Cisco are launching Shirudo, an open-source runtime that helps teams protect Linux systems while they roll out patches. In a </span><a href=\"https://isovalent.com/blog/post/cisco-openai-shirudo/\" class=\"transition ease-curve-a duration-250 text-primary-100 hover:text-primary-60 underline-offset-[0.25rem] decoration-1 underline relative\" target=\"_blank\" rel=\"noopener noreferrer\"><u class=\"decoration-1 underline-offset-4\"><span>controlled test</span></u>⁠<span class=\"sr-only\">(opens in a new window)</span></a><span>, a Codex-generated shield blocked a Java4Shell exploit attempt against a running Elasticsearch service without requiring a restart.</span></p>\n    </div>\n    <div class=\"col-span-full toc-visible:@md:col-start-2 max-w-none min-w-0 in-[:where(li)]:contents not-first:mt-6\">\n     <p class=\"mb-(--prose-body-margin-bottom,--spacing(6)) last:mb-0\"><span>We’re inviting developers, security researchers, and infrastructure operators across the industry to help develop the project further. The project brings together OpenAI’s frontier AI, security and infrastructure research and Cisco’s infrastructure and security expertise to help protect the systems people rely on every day.</span></p>\n    </div>\n    <div class=\"col-span-full toc-visible:@md:col-start-2 max-w-none min-w-0 in-[:where(li)]:contents not-first:mt-6\">\n     <p class=\"mb-(--prose-body-margin-bottom,--spacing(6)) last:mb-0\"><span>Testing and deploying a patch can still take days or weeks. Protecting a service in the meantime can be challenging because an exploit and a legitimate request may rely on the same Linux operation. Blocking that operation entirely could take the service offline.</span></p>\n    </div>\n    <div class=\"col-span-full toc-visible:@md:col-start-2 max-w-none min-w-0 in-[:where(li)]:contents not-first:mt-6\">\n     <p class=\"mb-(--prose-body-margin-bottom,--spacing(6)) last:mb-0\"><span>Shirudo (Japanese for “shield”) is designed to help security teams navigate this tradeoff. Teams can test whether a temporary safeguard, called a shield, blocks the behavior that exposes a vulnerability while allowing legitimate requests through. Once an operator approves the shield, it can be deployed while the service continues running. </span></p>\n    </div>\n    <div class=\"group col-span-full not-first:mt-6 py-8\">\n     <section class=\"w-full toc-visible:md:grid-cols-10 gap-x-(--grid-gap) [--grid-gap:8px] md:[--grid-gap:16px] lg:[--grid-gap:24px]\">\n      <div class=\"col-span-full toc-visible:@md:col-start-1\">\n       <div data-testid=\"testimonial-carousel-carousel-view\">\n        <div class=\"border-primary-12 bg-secondary-100 dark:border-primary-4 dark:bg-tertiary-100 relative rounded-md border shadow-[0_18px_60px_rgb(0_0_0/0.08)] px-6 py-8\">\n         <div data-testid=\"testimonial-carousel-scroll-region\" class=\"no-scrollbar relative scroll-smooth overflow-visible\">\n          <div class=\"sticky inset-s-0 top-0 w-full\">\n           <figure class=\"row-start-1 gap-5 self-start transition-opacity duration-250 ease-[cubic-bezier(0.23,1,0.32,1)] opacity-100\">\n            <blockquote class=\"relative ms-[0.5em] text-h5 font-medium tracking-tight text-pretty text-primary-100\">\n             <span class=\"absolute inset-s-[-0.5em] top-0\">“</span><span>We’re giving defenders better models and tools to find and fix vulnerabilities faster, but finding a bug today doesn’t mean you can patch every system tomorrow. We are partnering closely with Cisco on Shirudo to help teams protect the systems they need to keep running while they build and roll out a fix. So many teams rely on the same software that it makes sense to build these tools in the open. Now when one team finds a better way to protect a system, others don’t have to start from scratch.</span>”\n            </blockquote>\n            <figcaption class=\"ms-[0.5em] text-meta text-primary-60\">\n             <span>Greg Brockman, President and Co-founder of OpenAI</span>\n            </figcaption>\n           </figure>\n          </div>\n         </div>\n        </div>\n       </div>\n      </div>\n     </section>\n    </div>\n    <div class=\"col-span-full toc-visible:@md:col-start-2 max-w-none min-w-0 in-[:where(li)]:contents not-first:mt-16\">\n     <div class=\"w-full toc-visible:md:grid-cols-10 gap-x-(--grid-gap) [--grid-gap:8px] md:[--grid-gap:16px] lg:[--grid-gap:24px] toc-content-heading scroll-mt-[calc(var(--page-top-space,var(--header-h))+var(--toc-button-h)+var(--anchor-scroll-clearance))]\" id=\"how-shirudo-works\">\n      <div class=\"full-grid-content:@md:col-span-full full-grid-content:@md:col-start-1 max-w-none col-span-full toc-visible:@md:col-start-2\">\n       <h2 class=\"text-h3 scroll-mt-[calc(var(--page-top-space,var(--header-h))+var(--toc-button-h)+var(--anchor-scroll-clearance))]\"><span>How Shirudo works</span></h2>\n      </div>\n     </div>\n    </div>\n    <div class=\"col-span-full toc-visible:@md:col-start-2 max-w-none min-w-0 in-[:where(li)]:contents not-first:mt-6\">\n     <p class=\"mb-(--prose-body-margin-bottom,--spacing(6)) last:mb-0\"><span>Shirudo uses eBPF, a Linux technology that allows small programs to run at specific points inside the operating system. This makes it possible to observe suspicious activity and apply targeted security protections to running systems.</span></p>\n    </div>\n    <div class=\"group col-span-full not-first:mt-16 not-last:mb-16\">\n     <figure class=\"w-full toc-visible:md:grid-cols-10 gap-x-(--grid-gap) [--grid-gap:8px] md:[--grid-gap:16px] lg:[--grid-gap:24px] scroll-mt-[calc(var(--page-top-space,var(--header-h))+var(--toc-button-h)+var(--anchor-scroll-clearance))]\">\n      <div data-tabs-autoplay-content=\"true\" class=\"col-span-full flex min-h-0 flex-col gap-6 toc-visible:@md:col-start-2\">\n       <div data-figure-content=\"true\" class=\"flex min-h-0 w-full min-w-0 flex-col gap-6 @sm:flex-row @sm:gap-x-10 @sm:has-[&gt;:nth-child(2),&gt;[data-dotcom-chart-group]&gt;:nth-child(2)]:[--dotcom-chart-edge-gutter:0px] [&amp;_[data-dotcom-chart-logical-container][style*='width:_min-content']]:[--dotcom-chart-edge-gutter:0px] [--dotcom-chart-edge-gutter:var(--container-inline-gutter,0px)] md:[--dotcom-chart-edge-gutter:0px] shaded-container:[--dotcom-chart-edge-gutter:0px] items-start\">\n        <div class=\"w-full mx-auto transition-opacity duration-medium ease-curve-c max-w-container-desktop relative min-h-0\">\n         <div class=\"relative min-h-0 w-full\">\n          <div class=\"size-full\">\n           <div class=\"group relative overflow-hidden rounded-md aspect-auto size-full bg-surface-loading\">\n            <picture class=\"mx-auto\"><source media=\"(min-width: 768px) and (prefers-color-scheme: dark)\" srcset=\"https://media.bestblogs.dev/20261123222458_guardian-agent-desktop-dark.png 640w, https://media.bestblogs.dev/20261123222459_guardian-agent-desktop-dark.png 750w, https://media.bestblogs.dev/20261123222459_guardian-agent-desktop-dark.png 828w, https://media.bestblogs.dev/20261123222459_guardian-agent-desktop-dark.png 1080w, https://media.bestblogs.dev/20261123222458_guardian-agent-desktop-dark.png 1200w, https://media.bestblogs.dev/20261123222459_guardian-agent-desktop-dark.png 1920w, https://media.bestblogs.dev/20261123222459_guardian-agent-desktop-dark.png 2048w, https://media.bestblogs.dev/20261123222458_guardian-agent-desktop-dark.png 3840w\"><source media=\"(min-width: 768px)\" srcset=\"https://media.bestblogs.dev/20261123222459_guardian-agent-desktop-light.png 640w, https://media.bestblogs.dev/20261123222459_guardian-agent-desktop-light.png 750w, https://media.bestblogs.dev/20261123222459_guardian-agent-desktop-light.png 828w, https://media.bestblogs.dev/20261123222459_guardian-agent-desktop-light.png 1080w, https://media.bestblogs.dev/20261123222459_guardian-agent-desktop-light.png 1200w, https://media.bestblogs.dev/20261123222459_guardian-agent-desktop-light.png 1920w, https://media.bestblogs.dev/20261123222458_guardian-agent-desktop-light.png 2048w, https://media.bestblogs.dev/20261123222459_guardian-agent-desktop-light.png 3840w\"><source media=\"(max-width: 767px) and (prefers-color-scheme: dark)\" srcset=\"https://media.bestblogs.dev/20261123222459_guardian-agent-mobile-dark.png 640w, https://media.bestblogs.dev/20261123222458_guardian-agent-mobile-dark.png 750w, https://media.bestblogs.dev/20261123222459_guardian-agent-mobile-dark.png 828w, https://media.bestblogs.dev/20261123222459_guardian-agent-mobile-dark.png 1080w, https://media.bestblogs.dev/20261123222459_guardian-agent-mobile-dark.png 1200w, https://media.bestblogs.dev/20261123222459_guardian-agent-mobile-dark.png 1920w, https://media.bestblogs.dev/20261123222459_guardian-agent-mobile-dark.png 2048w, https://media.bestblogs.dev/20261123222458_guardian-agent-mobile-dark.png 3840w\"><source media=\"(max-width: 767px)\" srcset=\"https://media.bestblogs.dev/20261123222459_guardian-agent-mobile-light.png 640w, https://media.bestblogs.dev/20261123222459_guardian-agent-mobile-light.png 750w, https://media.bestblogs.dev/20261123222459_guardian-agent-mobile-light.png 828w, https://media.bestblogs.dev/20261123222458_guardian-agent-mobile-light.png 1080w, https://media.bestblogs.dev/20261123222459_guardian-agent-mobile-light.png 1200w, https://media.bestblogs.dev/20261123222459_guardian-agent-mobile-light.png 1920w, https://media.bestblogs.dev/20261123222459_guardian-agent-mobile-light.png 2048w, https://media.bestblogs.dev/20261123222459_guardian-agent-mobile-light.png 3840w\"><img alt=\"The guardian agent uses eBPF instruments to observe kernel and network activity and eBPF controls to apply targeted protections.\" data-nosnippet=\"true\" loading=\"lazy\" decoding=\"async\" data-nimg=\"1\" class=\"mx-auto\" style=\"color:transparent\" sizes=\"(min-width: 1728px) 1728px, 100vw\" srcset=\"https://media.bestblogs.dev/20261123222459_guardian-agent-desktop-light.png 640w, https://media.bestblogs.dev/20261123222459_guardian-agent-desktop-light.png 750w, https://media.bestblogs.dev/20261123222459_guardian-agent-desktop-light.png 828w, https://media.bestblogs.dev/20261123222459_guardian-agent-desktop-light.png 1080w, https://media.bestblogs.dev/20261123222459_guardian-agent-desktop-light.png 1200w, https://media.bestblogs.dev/20261123222459_guardian-agent-desktop-light.png 1920w, https://media.bestblogs.dev/20261123222459_guardian-agent-desktop-light.png 2048w, https://media.bestblogs.dev/20261123222458_guardian-agent-desktop-light.png 3840w\" src=\"https://media.bestblogs.dev/20261123222458_guardian-agent-desktop-light.png\"></picture>\n           </div>\n          </div>\n         </div>\n        </div>\n       </div>\n       <figcaption class=\"col-span-full flex w-full flex-col items-center gap-3 text-caption\">\n        <div class=\"relative mt-3 w-full\">\n         <div class=\"flex w-full items-end justify-between\">\n          <div class=\"grow\">\n           <div class=\"text-copy-secondary text-caption text-pretty line-clamp-2\">\n            <div class=\"prose prose-caption my-0! max-w-none\">\n             <p class=\"mb-(--prose-body-margin-bottom,--spacing(6)) last:mb-0\"><span>How the guardian agent observes and protects a running system with eBPF.</span></p>\n            </div>\n           </div>\n          </div>\n         </div>\n        </div>\n       </figcaption>\n      </div>\n     </figure>\n    </div>\n    <div class=\"col-span-full toc-visible:@md:col-start-2 max-w-none min-w-0 in-[:where(li)]:contents not-first:mt-6\">\n     <p class=\"mb-(--prose-body-margin-bottom,--spacing(6)) last:mb-0\"><span>OpenAI and Cisco are designing Shirudo around four core capabilities:</span></p>\n    </div>\n    <div class=\"col-span-full toc-visible:@md:col-start-2 max-w-none min-w-0 in-[:where(li)]:contents not-first:mt-6\">\n     <ul class=\"mb-8 marker:text-inherit last:mb-0 in-[:where(ul,ol)]:mt-2 list-disc in-[:where(ul,ol)]:list-[circle] mx-3 ps-4\">\n      <li class=\"mb-2 [&amp;&gt;p:only-of-type]:mb-0\">\n       <p class=\"mb-(--prose-body-margin-bottom,--spacing(6)) last:mb-0\"><b><span>Live protection:</span></b><span> eBPF shields can block vulnerable code paths without restarting the system. Security teams can monitor how a proposed shield would affect applications before enforcing it.</span></p>\n      </li>\n      <li class=\"mb-2 [&amp;&gt;p:only-of-type]:mb-0\">\n       <p class=\"mb-(--prose-body-margin-bottom,--spacing(6)) last:mb-0\"><b><span>Defense at machine speed:</span></b><span> OpenAI and Cisco are designing Shirudo to give agents programmable controls to investigate vulnerabilities, develop targeted shields, and validate their effectiveness against exploits and real workloads. Security teams control what gets deployed.</span></p>\n      </li>\n      <li class=\"mb-2 [&amp;&gt;p:only-of-type]:mb-0\">\n       <p class=\"mb-(--prose-body-margin-bottom,--spacing(6)) last:mb-0\"><b><span>Trusted deployment:</span></b><span> Shields are cryptographically signed and verified before loading. Linux's eBPF verifier checks eBPF programs against its safety rules, while kernel security controls restrict unauthorized changes.</span></p>\n      </li>\n      <li class=\"mb-2 [&amp;&gt;p:only-of-type]:mb-0\">\n       <p class=\"mb-(--prose-body-margin-bottom,--spacing(6)) last:mb-0\"><b><span>Hardware-backed verification:</span></b><span> Shirudo uses a Trusted Platform Module (TPM) to support a verifiable record of protections being loaded or removed. Operators can use this evidence to check whether systems meet their security requirements.</span></p>\n      </li>\n     </ul>\n    </div>\n    <div class=\"col-span-full toc-visible:@md:col-start-2 max-w-none min-w-0 in-[:where(li)]:contents not-first:mt-6\">\n     <p class=\"mb-(--prose-body-margin-bottom,--spacing(6)) last:mb-0\"><span>The </span><a href=\"https://lpc.events/event/20/contributions/2437/\" class=\"transition ease-curve-a duration-250 text-primary-100 hover:text-primary-60 underline-offset-[0.25rem] decoration-1 underline relative\" target=\"_blank\" rel=\"noopener noreferrer\"><u class=\"decoration-1 underline-offset-4\"><span>Shirudo technical walkthrough</span></u>⁠<span class=\"sr-only\">(opens in a new window)</span></a><span> from the Linux Plumbers Conference shows how to </span><a href=\"https://www.youtube.com/watch?v=4v2xA_NJHt0\" class=\"transition ease-curve-a duration-250 text-primary-100 hover:text-primary-60 underline-offset-[0.25rem] decoration-1 underline relative\" target=\"_blank\" rel=\"noopener noreferrer\"><u class=\"decoration-1 underline-offset-4\"><span>apply a shield and verify it on the target host</span></u>⁠<span class=\"sr-only\">(opens in a new window)</span></a><span>. The Java4Shell vulnerability is another example illustrating how a targeted shield can protect a running application while a permanent patch is being prepared. Using OpenAI's Codex, the team generated a shield that added an input check to Java's Base64 decoder and attached it directly to a running Elasticsearch process. When attempting to exploit the vulnerability, the shield rejected the malicious input, blocking the attack while Elasticsearch continued running. You can read more </span><a href=\"https://isovalent.com/blog/post/cisco-openai-shirudo/\" class=\"transition ease-curve-a duration-250 text-primary-100 hover:text-primary-60 underline-offset-[0.25rem] decoration-1 underline relative\" target=\"_blank\" rel=\"noopener noreferrer\"><u class=\"decoration-1 underline-offset-4\"><span>here</span></u>⁠<span class=\"sr-only\">(opens in a new window)</span></a><span>.</span></p>\n    </div>\n    <div class=\"col-span-full toc-visible:@md:col-start-2 max-w-none min-w-0 in-[:where(li)]:contents not-first:mt-16\">\n     <div class=\"w-full toc-visible:md:grid-cols-10 gap-x-(--grid-gap) [--grid-gap:8px] md:[--grid-gap:16px] lg:[--grid-gap:24px] toc-content-heading scroll-mt-[calc(var(--page-top-space,var(--header-h))+var(--toc-button-h)+var(--anchor-scroll-clearance))]\" id=\"rethinking-infrastructure\">\n      <div class=\"full-grid-content:@md:col-span-full full-grid-content:@md:col-start-1 max-w-none col-span-full toc-visible:@md:col-start-2\">\n       <h2 class=\"text-h3 scroll-mt-[calc(var(--page-top-space,var(--header-h))+var(--toc-button-h)+var(--anchor-scroll-clearance))]\"><span>Rethinking infrastructure</span></h2>\n      </div>\n     </div>\n    </div>\n    <div class=\"col-span-full toc-visible:@md:col-start-2 max-w-none min-w-0 in-[:where(li)]:contents not-first:mt-6\">\n     <p class=\"mb-(--prose-body-margin-bottom,--spacing(6)) last:mb-0\"><span>Shirudo is a first step toward infrastructure that can adapt to emerging threats while remaining reliable. We want to strengthen the operating system foundations needed to deploy these protections at scale, including hardening the kernel and core services, limiting workload permissions, and making updates and recovery safer.</span></p>\n    </div>\n    <div class=\"col-span-full toc-visible:@md:col-start-2 max-w-none min-w-0 in-[:where(li)]:contents not-first:mt-6\">\n     <p class=\"mb-(--prose-body-margin-bottom,--spacing(6)) last:mb-0\"><span>Our long-term goal is to enable defenders and AI agents to quickly identify affected systems, validate protections, and deploy eBPF shields that block exploits without disrupting workloads. Applications should run with only the permissions they need, governed by policies that are automatically generated and maintained.</span></p>\n    </div>\n    <div class=\"col-span-full toc-visible:@md:col-start-2 max-w-none min-w-0 in-[:where(li)]:contents not-first:mt-6\">\n     <p class=\"mb-(--prose-body-margin-bottom,--spacing(6)) last:mb-0\"><span>We will combine frontier AI with security and infrastructure research to discover vulnerabilities and test defenses against realistic attacks. We aim to make it easier for operators to detect and contain compromises, prevent attackers from moving across systems, and restore services to a verified, known-good state. Hardware-backed attestation and independent network controls provide additional assurance even if individual systems are compromised.</span></p>\n    </div>\n    <div class=\"col-span-full toc-visible:@md:col-start-2 max-w-none min-w-0 in-[:where(li)]:contents not-first:mt-16\">\n     <div class=\"w-full toc-visible:md:grid-cols-10 gap-x-(--grid-gap) [--grid-gap:8px] md:[--grid-gap:16px] lg:[--grid-gap:24px] toc-content-heading scroll-mt-[calc(var(--page-top-space,var(--header-h))+var(--toc-button-h)+var(--anchor-scroll-clearance))]\" id=\"building-in-the-open\">\n      <div class=\"full-grid-content:@md:col-span-full full-grid-content:@md:col-start-1 max-w-none col-span-full toc-visible:@md:col-start-2\">\n       <h2 class=\"text-h3 scroll-mt-[calc(var(--page-top-space,var(--header-h))+var(--toc-button-h)+var(--anchor-scroll-clearance))]\"><span>Building in the open</span></h2>\n      </div>\n     </div>\n    </div>\n    <div class=\"col-span-full toc-visible:@md:col-start-2 max-w-none min-w-0 in-[:where(li)]:contents not-first:mt-6\">\n     <p class=\"mb-(--prose-body-margin-bottom,--spacing(6)) last:mb-0\"><span>OpenAI and Cisco are open-sourcing</span><span> </span><a href=\"https://github.com/shirudo-dev/shirudo\" class=\"transition ease-curve-a duration-250 text-primary-100 hover:text-primary-60 underline-offset-[0.25rem] decoration-1 underline relative\" target=\"_blank\" rel=\"noopener noreferrer\"><u class=\"decoration-1 underline-offset-4\"><span>Shirudo</span></u>⁠<span class=\"sr-only\">(opens in a new window)</span></a><span> so developers, security researchers, and infrastructure operators can inspect the code, test protections, and contribute to its development. Shirudo is licensed under BSD 2-Clause, with its BPF programs dual-licensed under BSD and GPL.</span></p>\n    </div>\n    <div class=\"col-span-full toc-visible:@md:col-start-2 max-w-none min-w-0 in-[:where(li)]:contents not-first:mt-6\">\n     <p class=\"mb-(--prose-body-margin-bottom,--spacing(6)) last:mb-0\"><span>Our goal is to make tested shields available alongside vulnerability disclosures, giving operators a way to evaluate and deploy temporary protections while preparing permanent patches.</span></p>\n    </div>\n    <div class=\"col-span-full toc-visible:@md:col-start-2 max-w-none min-w-0 in-[:where(li)]:contents not-first:mt-6\">\n     <ul class=\"mb-8 marker:text-inherit last:mb-0 in-[:where(ul,ol)]:mt-2 list-disc in-[:where(ul,ol)]:list-[circle] mx-3 ps-4\">\n      <li class=\"mb-2 [&amp;&gt;p:only-of-type]:mb-0\">\n       <p class=\"mb-(--prose-body-margin-bottom,--spacing(6)) last:mb-0\"><b><span>Try Shirudo:</span></b><span> Follow the</span><span> </span><a href=\"https://docs.shirudo.dev/start/quickstart.html\" class=\"transition ease-curve-a duration-250 text-primary-100 hover:text-primary-60 underline-offset-[0.25rem] decoration-1 underline relative\" target=\"_blank\" rel=\"noopener noreferrer\"><u class=\"decoration-1 underline-offset-4\"><span>VM quickstart</span></u>⁠<span class=\"sr-only\">(opens in a new window)</span></a><span> to sign, load, and verify a test protection.</span></p>\n      </li>\n      <li class=\"mb-2 [&amp;&gt;p:only-of-type]:mb-0\">\n       <p class=\"mb-(--prose-body-margin-bottom,--spacing(6)) last:mb-0\"><b><span>Get hands-on:</span></b><span> Explore Shirudo through </span><a href=\"https://labs.isovalent.com/#/lab/shirudo-getting-started\" class=\"transition ease-curve-a duration-250 text-primary-100 hover:text-primary-60 underline-offset-[0.25rem] decoration-1 underline relative\" target=\"_blank\" rel=\"noopener noreferrer\"><u class=\"decoration-1 underline-offset-4\"><span>Isovalent's self-guided lab</span></u>⁠<span class=\"sr-only\">(opens in a new window)</span></a><span>.</span></p>\n      </li>\n      <li class=\"mb-2 [&amp;&gt;p:only-of-type]:mb-0\">\n       <p class=\"mb-(--prose-body-margin-bottom,--spacing(6)) last:mb-0\"><b><span>Join the technical deep dive:</span></b><span> Register for the </span><a href=\"https://isovalent.site/4t8Pjxc\" class=\"transition ease-curve-a duration-250 text-primary-100 hover:text-primary-60 underline-offset-[0.25rem] decoration-1 underline relative\" target=\"_blank\" rel=\"noopener noreferrer\"><u class=\"decoration-1 underline-offset-4\"><span>December 15 webinar</span></u>⁠<span class=\"sr-only\">(opens in a new window)</span></a><span>.</span></p>\n      </li>\n     </ul>\n    </div>\n    <div class=\"col-span-full toc-visible:@md:col-start-2 max-w-none min-w-0 in-[:where(li)]:contents not-first:mt-6\">\n     <p class=\"mb-(--prose-body-margin-bottom,--spacing(6)) last:mb-0\"><span>We’re building Shirudo in the open with the people who build, run, and secure Linux systems. We welcome contributions to the runtime, new shields, and improvements to Linux and eBPF. If you'd like to get involved, take a look at the</span><span> </span><a href=\"https://github.com/shirudo-dev/shirudo\" class=\"transition ease-curve-a duration-250 text-primary-100 hover:text-primary-60 underline-offset-[0.25rem] decoration-1 underline relative\" target=\"_blank\" rel=\"noopener noreferrer\"><u class=\"decoration-1 underline-offset-4\"><span>code on GitHub</span></u>⁠<span class=\"sr-only\">(opens in a new window)</span></a><span>, read the</span><span> </span><a href=\"https://docs.shirudo.dev/index.html\" class=\"transition ease-curve-a duration-250 text-primary-100 hover:text-primary-60 underline-offset-[0.25rem] decoration-1 underline relative\" target=\"_blank\" rel=\"noopener noreferrer\"><u class=\"decoration-1 underline-offset-4\"><span>docs</span></u>⁠<span class=\"sr-only\">(opens in a new window)</span></a><span>, and</span><span> </span><a href=\"https://docs.shirudo.dev/contribute/support.html\" class=\"transition ease-curve-a duration-250 text-primary-100 hover:text-primary-60 underline-offset-[0.25rem] decoration-1 underline relative\" target=\"_blank\" rel=\"noopener noreferrer\"><u class=\"decoration-1 underline-offset-4\"><span>let us know what you find</span></u>⁠<span class=\"sr-only\">(opens in a new window)</span></a><span>. </span></p>\n    </div>\n   </div>\n  </div>\n  <section id=\"citations\" data-testid=\"citations\" class=\"w-full scroll-mt-anchor-offset\">\n   <div class=\"rounded-md bg-primary-4 py-8 md:py-16 toc-visible:md:grid-cols-10 gap-x-(--grid-gap) [--grid-gap:8px] md:[--grid-gap:16px] lg:[--grid-gap:24px]\">\n    <div class=\"flex flex-col gap-8 px-5 col-span-full toc-visible:@md:col-start-2\">\n     <section class=\"w-full\">\n      <ul class=\"flex flex-wrap gap-3\">\n       <li><a class=\"transition ease-curve-a duration-250 block rounded-xl bg-primary-4 px-3 py-2! text-nav hover:bg-primary-12\" href=\"https://openai.com/news/?tags=partnerships\">Partnerships</a></li>\n       <li><a class=\"transition ease-curve-a duration-250 block rounded-xl bg-primary-4 px-3 py-2! text-nav hover:bg-primary-12\" href=\"https://openai.com/news/?tags=2026\">2026</a></li>\n      </ul>\n     </section>\n     <div data-testid=\"author-list\">\n      <h2 class=\"mb-3 text-p2 text-primary-60\">Author</h2>\n      <div class=\"text-p2\">OpenAI</div>\n     </div>\n    </div>\n   </div>\n  </section>\n  <div class=\"w-full\">\n   <div class=\"mb-8 flex items-baseline justify-between\">\n    <div>\n     <h2 class=\"text-h4 text-primary-100\">Keep reading</h2>\n    </div>\n    <a class=\"transition duration-short ease-curve-a rounded-[2.5rem] text-nowrap min-h-8 flex items-center justify-center gap-[0.3em] text-cta focus:outline outline-offset-2 h-[2.5rem] min-h-0 text-primary-100 hover:text-primary-60 disabled:text-primary-44 focus:outline-none focus-visible:outline-primary-44 px-0 !rounded\" href=\"https://openai.com/news/\">View all</a>\n   </div>\n   <div class=\"flex w-auto\">\n    <div class=\"w-full toc-collision-target no-scrollbar overflow-x-auto overflow-y-hidden\">\n     <div class=\"flex min-w-4xl px-6 pe-6 flex-none\">\n      <div class=\"relative mb-8 ps-6 min-w-[calc(100%/3)] ps-0 last:me-0\">\n       <div class=\"group relative\">\n        <div class=\"rounded-md [&amp;_img]:translate-0 [&amp;_video]:translate-0 [&amp;_img]:scale-100 [&amp;_img]:transition-transform [&amp;_img]:duration-300 [&amp;_video]:transition-transform [&amp;_video]:duration-200 **:data-media-overlay-text:scale-100 **:data-media-overlay-text:transition-transform **:data-media-overlay-text:duration-300 group-hover:[&amp;_img]:scale-102.5 group-hover:[&amp;_video]:scale-102.5 group-hover:**:data-media-overlay-text:scale-102.5 w-full mx-auto transition-opacity duration-medium ease-curve-c max-w-container-desktop relative min-h-0 overflow-hidden\">\n         <div class=\"relative min-h-0 w-full\" style=\"aspect-ratio:1/1\">\n          <div class=\"size-full\">\n           <div class=\"group relative overflow-hidden rounded-none image-aspect-center aspect-(--image-aspect-ratio) max-h-full max-w-full bg-surface-loading\" style=\"--image-aspect-ratio:1/1\">\n            <img alt=\"Partnering with Hacktron to find vulnerabilities in OpenAI’s systems — Cover\" data-nosnippet=\"true\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover object-center\" style=\"top:0;color:transparent;left:0;bottom:0;right:0;\" sizes=\"(min-width: 1728px) 1728px, 100vw\" srcset=\"https://media.bestblogs.dev/20261123222459_partnering-with-hacktron-cover.png 640w, https://media.bestblogs.dev/20261123222459_partnering-with-hacktron-cover.png 750w, https://media.bestblogs.dev/20261123222459_partnering-with-hacktron-cover.png 828w, https://media.bestblogs.dev/20261123222459_partnering-with-hacktron-cover.png 1080w, https://media.bestblogs.dev/202611