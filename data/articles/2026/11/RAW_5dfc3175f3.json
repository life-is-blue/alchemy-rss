  "content": "<html>\n <head></head>\n <body>\n  <div class=\"w-full\">\n   <div class=\"relative w-full\" style=\"--hero-aspect-ratio:16/9;--hero-aspect-ratio-mobile:1/1\">\n    <div data-section-header=\"true\" class=\"w-full toc-visible:md:grid-cols-10 gap-x-(--grid-gap) [--grid-gap:8px] md:[--grid-gap:16px] lg:[--grid-gap:24px]\">\n     <div class=\"col-span-full toc-visible:@md:col-span-8 toc-visible:@md:col-start-1\">\n      <div class=\"relative flex flex-col items-center text-center\">\n       <div data-article-hero-copy-region=\"meta\" class=\"mb-8 flex flex-wrap gap-4 justify-center\">\n        <p class=\"text-meta text-primary-100\">November 23, 2026</p>\n        <a class=\"transition ease-curve-a duration-250 text-meta text-primary-60 hover:text-primary-100\" href=\"https://openai.com/news/security/\">Security</a>\n       </div>\n       <div></div>\n       <div class=\"toc-visible:md:grid-cols-10 gap-x-(--grid-gap) [--grid-gap:8px] md:[--grid-gap:16px] lg:[--grid-gap:24px] mt-6 w-full\">\n        <p data-article-hero-copy-region=\"subhead\" class=\"col-span-full toc-collision-target text-primary-100 toc-visible:@md:col-start-1 justify-self-center text-balance\">An open-source runtime that helps operators protect running Linux systems without needing to wait for the patch or restarts</p>\n       </div>\n      </div>\n     </div>\n    </div>\n    <div data-article-hero-media=\"true\" class=\"relative z-0 toc-visible:md:grid-cols-10 gap-x-(--grid-gap) [--grid-gap:8px] md:[--grid-gap:16px] lg:[--grid-gap:24px] mt-12\">\n     <div class=\"col-span-full toc-collision-target toc-visible:@md:col-span-8 toc-visible:@md:col-start-1\">\n      <div class=\"col-span-full overflow-hidden\">\n       <div class=\"w-full mx-auto transition-opacity duration-medium ease-curve-c max-w-container-desktop relative min-h-0\">\n        <div class=\"relative min-h-0 w-full\" style=\"aspect-ratio: 16 / 9;\">\n         <div class=\"size-full\">\n          <div class=\"group relativ