, 253, 253); pointer-events: initial; visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;node&quot;,{&quot;tagName&quot;:&quot;span&quot;,&quot;attributes&quot;:{&quot;data-pm-slice&quot;:&quot;0 0 []&quot;,&quot;style&quot;:&quot;-webkit-tap-highlight-color: rgba(0, 0, 0, 0); margin: 0px; padding: 0px; outline: 0px; max-width: 100%; box-sizing: border-box; overflow-wrap: break-word !important; color: rgb(49, 49, 49); font-family: \\&quot;PingFang SC\\&quot;, system-ui, -apple-system, BlinkMacSystemFont, \\&quot;Helvetica Neue\\&quot;, \\&quot;Hiragino Sans GB\\&quot;, \\&quot;Microsoft YaHei UI\\&quot;, \\&quot;Microsoft YaHei\\&quot;, Arial, sans-serif; font-size: 15px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 700; letter-spacing: 1px; orphans: 2; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; pointer-events: initial; visibility: visible; display: inline !important;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;}]\" style=\"-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box;overflow-wrap: break-word !important;pointer-events: initial;visibility: visible;\">· · ·</span></span></p>\n  <h2 data-pm-slice=\"0 0 []\" style=\"-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0px 8px;padding: 0px 0px 0px 12px;outline: 0px;font-weight: 400;font-size: 20px;max-width: 100%;box-sizing: border-box;overflow-wrap: break-word !important;font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;orphans: 2;text-indent: 0px;text-transform: none;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;white-space: normal;text-decoration-thickness: initial;text-decoration-style: initial;text-decoration-color: initial;letter-spacing: normal;text-align: start;color: rgb(34, 34, 34);border-left: 4px solid rgb(231, 76, 60);font-family: -apple-system, &quot;PingFang SC&quot;, &quot;Helvetica Neue&quot;, Arial, sans-serif;background-color: rgb(253, 253, 253);pointer-events: initial;visibility: visible;\">\n   <p data-pm-slice=\"0 0 []\" style=\"-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0px 8px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;clear: both;min-height: 1em;visibility: visible;\"><span data-eleid=\"0cd8e73a-a67d-4b4b-8f19-9cfb653efd29-74-0\" style=\"-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;white-space: pre-wrap;visibility: visible;\"><span leaf=\"\" data-pm-slice=\"1 1 [&quot;para&quot;,{&quot;tagName&quot;:&quot;p&quot;,&quot;attributes&quot;:{&quot;data-pm-slice&quot;:&quot;0 0 []&quot;,&quot;style&quot;:&quot;margin-bottom: 8px;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;node&quot;,{&quot;tagName&quot;:&quot;span&quot;,&quot;attributes&quot;:{&quot;class&quot;:&quot;text-only&quot;,&quot;data-eleid&quot;:&quot;0cd8e73a-a67d-4b4b-8f19-9cfb653efd29-74-0&quot;,&quot;style&quot;:&quot;white-space: pre-wrap;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;}]\" style=\"-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;\"><span textstyle=\"\" style=\"font-size: 20px;font-weight: bold;\">AI开始抢传统软件公司的生意了</span></span></span></p>\n  </h2>\n  <p style=\"margin-bottom: 8px;\"><span leaf=\"\"><span textstyle=\"\" style=\"font-size: 15px;\">Compositor还不是个例。</span></span></p>\n  <p style=\"margin-bottom: 8px;\"><span leaf=\"\"><span textstyle=\"\" style=\"font-size: 15px;\">最近还有一个叫ArtCraft的开源项目，开发者借助AI编程，</span><span textstyle=\"\" style=\"font-size: 15px;font-weight: bold;\">一口气挑战Photoshop、Illustrator、Premiere等7类Adobe软件，甚至想把整套创意软件都重新做一遍。</span></span></p>\n  <p style=\"text-align: center;margin-bottom: 8px;\" nodeleaf=\"\"><img data-aistatus=\"1\" class=\"rich_pages wxw-img\" data-ratio=\"0.5398148148148149\" data-s=\"300,640\" data-type=\"jpeg\" data-w=\"1080\" type=\"block\" data-imgfileid=\"506169078\" src=\"https://media.bestblogs.dev/20261012174442_ee49069.png\"></p>\n  <p style=\"margin-bottom: 8px;\"><span leaf=\"\"><span textstyle=\"\" style=\"font-size: 15px;\">这些项目目前的质量确实参差不齐，有些还停留在演示阶段，但我觉得这个趋势已经很明显了。</span></span></p>\n  <p style=\"margin-bottom: 8px;\"><span leaf=\"\"><span textstyle=\"\" style=\"font-size: 15px;\">以前开发一款专业软件，得有一支工程师团队，花几年时间不断打磨。现在有了AI编程，</span><span textstyle=\"\" style=\"font-size: 15px;font-weight: bold;\">懂业务、懂产品的人，也可以自己动手做软件了</span><span textstyle=\"\" style=\"font-size: 15px;\">。</span></span></p>\n  <p style=\"text-align: center;margin-bottom: 8px;\" nodeleaf=\"\"><img data-aistatus=\"1\" class=\"rich_pages wxw-img\" data-ratio=\"1.1083333333333334\" data-s=\"300,640\" data-type=\"png\" data-w=\"1080\" type=\"block\" data-imgfileid=\"506169080\" src=\"https://media.bestblogs.dev/20261012174442_d105965.png\"></p>\n  <p style=\"margin-bottom: 8px;\"><span leaf=\"\"><span textstyle=\"\" style=\"font-size: 15px;\">而且对Adobe这样的公司来说，</span><span textstyle=\"\" style=\"font-size: 15px;font-weight: bold;\">威胁还不止来自开源平替</span><span textstyle=\"\" style=\"font-size: 15px;\">。</span></span></p>\n  <p style=\"margin-bottom: 8px;\"><span leaf=\"\"><span textstyle=\"\" style=\"font-size: 15px;\">比如我现在做短视频封面，已经有不少直接交给GPT生成了。过去需要打开Photoshop，选图、抠图、排版、调色，现在很多时候</span><span textstyle=\"\" style=\"font-size: 15px;font-weight: bold;\">一句话就能搞定，连软件都不用打开</span><span textstyle=\"\" style=\"font-size: 15px;\">。</span></span></p>\n  <p style=\"text-align: center;margin-bottom: 8px;\" nodeleaf=\"\"><img data-aistatus=\"1\" class=\"rich_pages wxw-img\" data-ratio=\"1.207161125319693\" data-s=\"300,640\" data-type=\"png\" data-w=\"782\" style=\"width: 100%;\" type=\"block\" data-backw=\"578\" data-backh=\"698\" data-imgfileid=\"506169079\" src=\"https://media.bestblogs.dev/20261012174442_727d162.png\"></p>\n  <p style=\"margin-bottom: 8px;\"><span leaf=\"\"><span textstyle=\"\" style=\"font-size: 15px;\">这其实是两种变化在同时发生：</span></span><strong><span leaf=\"\"><span textstyle=\"\" style=\"font-size: 15px;\">一边是AI让开发软件越来越容易，另一边是AI直接接管了原本需要软件完成的工作。</span></span></strong></p>\n  <p style=\"margin-bottom: 8px;\"><span leaf=\"\"><span textstyle=\"\" style=\"font-size: 15px;\">那些主要靠功能堆砌、长期收取高额订阅费的软件公司，接下来真得紧张起来了。</span></span></p>\n  <p data-pm-slice=\"3 4 []\" style=\"-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0px 8px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box;overflow-wrap: break-word !important;clear: both;min-height: 1em;font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;orphans: 2;text-indent: 0px;text-transform: none;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;white-space: normal;text-decoration-thickness: initial;text-decoration-style: initial;text-decoration-color: initial;letter-spacing: normal;color: rgb(51, 51, 51);font-family: -apple-system, &quot;PingFang SC&quot;, &quot;Helvetica Neue&quot;, Arial, sans-serif;font-size: 16px;text-align: center;background-color: rgb(253, 253, 253);pointer-events: initial;visibility: visible;\"><span data-pm-slice=\"0 0 []\" style=\"-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box;overflow-wrap: break-word !important;color: rgb(49, 49, 49);font-family: &quot;PingFang SC&quot;, system-ui, -apple-system, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, 