ediaPipe Decision Task API.\">\n          <!---->\n          <!--?lit$305792445$-->\n          <div class=\"uni-media-carousel__content\">\n           <!--?lit$305792445$-->\n           <!--?lit$305792445$-->\n           <div slot=\"content\" style=\"display: block;\">\n            <uni-media data-analytics-module=\"{\n    &quot;module_name&quot;: &quot;Media Carousel/Video&quot;,\n    &quot;section_header&quot;: &quot;EmbeddingGemma 2: an open, lightweight multimodal embedding model&quot;\n  }\" or-mp4-video-url=\"https://storage.googleapis.com/gweb-uniblog-publish-prod/original_videos/mediapipe-decision-api-embeddinggemma-2.mp4\" section-header=\"EmbeddingGemma 2: an open, lightweight multimodal embedding model\" alt-text=\"EmbeddingGemma 2 in the MediaPipe Decision Task API.\" video-title=\"Mediapipe decision API Embedding Gemma 2\">\n             <!---->\n             <div class=\"uni-media\">\n              <!--?lit$305792445$-->\n              <div class=\" uni-media__asset uni-media__asset--mp4 \">\n               <!--?lit$305792445$-->\n               <!--?lit$305792445$-->\n               <!--?lit$305792445$-->\n               <uni-video-player autoplay-override=\"\" muted playsinline=\"\" controls=\"\" type=\"video/mp4\" alt-text=\"EmbeddingGemma 2 in the MediaPipe Decision Task API.\" video-url=\"https://storage.googleapis.com/gweb-uniblog-publish-prod/original_videos/mediapipe-decision-api-embeddinggemma-2.mp4\" tts-json=\"[]\" audio-descripted-video=\"\" section-header=\"EmbeddingGemma 2: an open, lightweight multimodal embedding model\" video-title=\"Mediapipe decision API Embedding Gemma 2\">\n                <!---->\n                <div class=\"uni-video-player\">\n                 <!--?lit$305792445$-->\n                 <video crossorigin=\"anonymous\" muted playsinline=\"\" aria-label=\"EmbeddingGemma 2 in the MediaPipe Decision Task API.\" class=\" uni-video-player__video reduce-motion-disabled \" style=\"min-height:0px;\" preload=\"metadata\">\n                  <source type=\"video/mp4\" src=\"https://storage.googleapis.com/gweb-uniblog-publish-prod/original_videos/mediapipe-decision-api-embeddinggemma-2.mp4#t=0.001\">Sorry, your browser doesn't support embedded videos, but don't worry, you can <a download=\"\" href=\"https://storage.googleapis.com/gweb-uniblog-publish-prod/original_videos/mediapipe-decision-api-embeddinggemma-2.mp4\" rel=\"noopener\" target=\"_blank\">download it</a> and watch it with your favorite video player!\n                 </video>\n                 <!--?lit$305792445$-->\n                 <div class=\" uni-video-player__controls uni-video-player__controls--unstarted \">\n                  <!--?lit$305792445$-->\n                  <button class=\" uni-video-player__button uni-video-player__button--main uni-video-player__button--main--active \" aria-label=\"Play video\"><uni-icon-component icon-id=\"play-arrow\"><!----></uni-icon-component></button>\n                 </div>\n                </div>\n               </uni-video-player>\n               <!--?-->\n              </div>\n             </div>\n            </uni-media>\n           </div>\n          </div>\n          <!--?lit$305792445$-->\n          <div class=\"uni-media-carousel__caption\">\n           <uni-collapsable-caption collapsed-lines=\"2\" accordion-header=\"Create real-time decision engines leveraging multimodal context for classification, routing, and predictive capabilities via the MediaPipe Decision Task API.\" class=\"uni-collapsable-caption\">\n            <!---->\n            <div class=\"uni-collapsable-caption__content\" style=\"--collapsed-lines:2\">\n             <!--?lit$305792445$-->\n             <!---->\n             <div class=\"uni-collapsable-caption__body\">\n              <!--?lit$305792445$-->\n              <div slot=\"caption\" class=\"font-caption\" style=\"display: block;\">\n               <div class=\"uni-media-carousel__caption-within\">\n                <div>\n                 <div class=\"rich-text\">\n                  <p data-block-key=\"pzx0s\">Create real-time decision engines leveraging multimodal context for classification, routing, and predictive capabilities via the <a href=\"https://developers.google.com/edge/mediapipe/solutions/decision/decision_maker\" rel=\"noopener\" target=\"_blank\">MediaPipe Decision Task API</a>.</p>\n                 </div>\n                </div>\n               </div>\n              </div>\n             </div>\n             <!---->\n            </div>\n            <!--?lit$305792445$-->\n            <!--?-->\n           </uni-collapsable-caption>\n          </div>\n          <!--?-->\n         </uni-media-carousel-slide>\n        </div>\n        <!---->\n       </div>\n      </div>\n     </uni-media-carousel-viewport>\n     <!--?lit$305792445$-->\n     <div slot=\"controls\" style=\"display: block;\">\n      <div class=\"uni-media-carousel__controls-container\">\n       <uni-carousel-controls class=\"uni-media-carousel__controls\">\n        <!---->\n        <div class=\"uni-carousel-controls\">\n         <div class=\"uni-carousel-controls__arrows\">\n          <button class=\"uni-carousel-controls__btn uni-carousel-controls__btn--prev\" aria-label=\"Previous item\" disabled>\n           <svg viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n            <path d=\"M15.41 16.59L10.83 12L15.41 7.41L14 6L8 12L14 18L15.41 16.59Z\" fill=\"currentColor\"></path>\n           </svg>\n          </button>\n          <button class=\"uni-carousel-controls__btn uni-carousel-controls__btn--next\" aria-label=\"Next item\">\n           <svg viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n            <path d=\"M8.59 16.59L13.17 12L8.59 7.41L10 6L16 12L10 18L8.59 16.59Z\" fill=\"currentColor\"></path>\n           </svg>\n          </button>\n         </div>\n         <div class=\"uni-carousel-controls__progress-wrapper\">\n          <div class=\"uni-carousel-controls__progress-bar\"></div>\n         </div>\n        </div>\n       </uni-carousel-controls>\n      </div>\n     </div>\n    </div>\n   </uni-media-carousel>\n  </section>\n  <section class=\"uni-page uni-grid uni-article-paragraph\" data-analytics-module=\"{\n    &quot;module_name&quot;: &quot;Paragraph&quot;,\n    &quot;section_header&quot;: &quot;EmbeddingGemma 2: an open, lightweight multimodal embedding model&quot;\n  }\">\n   <uni-article-paragraph class=\"uni-article-paragraph__container uni-grid__col--layout-6\">\n    <div class=\"rich-text\">\n     <p data-block-key=\"qbc6m\">To learn how to build on-device search and RAG systems with LiteRT, read the <a href=\"http://developers.googleblog.com/google-ai-edge-with-embeddinggemma-2\" rel=\"noopener\" target=\"_blank\">Google AI Edge blog post</a>.</p>\n    </div>\n    <!---->\n   </uni-article-paragraph>\n  </section>\n  <section class=\"uni-page uni-grid uni-article-paragraph\" data-analytics-module=\"{\n    &quot;module_name&quot;: &quot;Paragraph&quot;,\n    &quot;section_header&quot;: &quot;EmbeddingGemma 2: an open, lightweight multimodal embedding model&quot;\n  }\">\n   <uni-article-paragraph class=\"uni-article-paragraph__container uni-grid__col--layout-6\">\n    <div class=\"rich-text\">\n     <h2 data-block-key=\"nmcpy\">Getting started with EmbeddingGemma 2</h2>\n     <p data-block-key=\"b5kgo\">We worked closely with the following partners to ensure EmbeddingGemma 2 works immediately where you build:</p>\n     <ul>\n      <li data-block-key=\"5t3vm\"><b>Download the models:</b> Find the model weights on <a href=\"https://huggingface.co/google/embeddinggemma-2\" rel=\"noopener\" target=\"_blank\">Hugging Face</a> and <a href=\"https://www.kaggle.com/models/google/embeddinggemma-2\" rel=\"noopener\" target=\"_blank\">Kaggle</a>, with Gemini Enterprise Agent Platform Model Garden availability coming soon. Visit <a href=\"https://huggingface.co/litert-community\" rel=\"noopener\" target=\"_blank\">LiteRT Community on Hugging Face</a> for models optimized for on-device.</li>\n      <li data-block-key=\"36c73\"><b>On-device deployment:</b> Develop cross-platform apps with Google AI Edge <a href=\"https://developers.google.com/edge/mediapipe/solutions/decision/decision_maker\" rel=\"noopener\" target=\"_blank\">MediaPipe</a> for turnkey embedding, retrieval &amp; decision tasks or <a href=\"https://developers.google.com/edge/litert-lm\" rel=\"noopener\" target=\"_blank\">LiteRT</a> for custom model integration. Build for the browser with transformers.js or <a href=\"https://huggingface.co/spaces/webml-community/embeddinggemma-2-webgpu\" rel=\"noopener\" target=\"_blank\">WebGPU</a>.</li>\n      <li data-block-key=\"9gcit\"><b>Use your favorite development tools</b>: Serve the model efficiently using transformers, sentence-transformers, <a href=\"https://github.com/Blaizzy/mlx-vlm\" rel=\"noopener\" target=\"_blank\">MLX</a>, vLLM, <a href=\"https://huggingface.co/ggml-org/embeddinggemma-2-GGUF\" rel=\"noopener\" target=\"_blank\">llama.cpp</a>, SGLang, <a href=\"http://ollama.com/library/embeddinggemma-2\" rel=\"noopener\" target=\"_blank\">Ollama</a>, and LMStudio. Store your embedding vectors with <a href=\"https://qdrant.tech/blog/embeddinggemma-2/\" rel=\"noopener\" target=\"_blank\">Qdrant</a>.</li>\n      <li data-block-key=\"a2leg\"><b>Fine-tuning:</b> Follow guidance by <a href=\"https://unsloth.ai/docs/models/embeddinggemma-2\" rel=\"noopener\" target=\"_blank\">Unsloth</a> for how to fine-tune EmbeddingGemma 2 for your use cases.</li>\n     </ul>\n     <p data-block-key=\"262nv\">Explore our <a href=\"https://developers.googleblog.com/en/embeddinggemma-2-the-developer-guide/\" rel=\"noopener\" target=\"_blank\">developer guide</a>, <a href=\"https://ai.google.dev/gemma/docs/embeddinggemma\" rel=\"noopener\" target=\"_blank\">documentation</a>, and guides for <a href=\"https://ai.google.dev/gemma/docs/embeddinggemma/inference-embeddinggemma-with-sentence-transformers\" rel=\"noopener\" target=\"_blank\">inference</a> and <a href=\"https://ai.google.dev/gemma/docs/embeddinggemma/fine-tuning-embeddinggemma-with-sentence-transformers\" rel=\"noopener\" target=\"_blank\">fine-tuning</a>.</p>\n    </div>\n    <!---->\n   </uni-article-paragraph>\n  </section>\n </body>\n</html>",
  "aiSummary": "Google 发布 EmbeddingGemma 2，这是一个 7.4 亿参数的模型，整合了文本、代码、图像、视频和音频嵌入，在其尺寸下实现了最佳性能，支持高效的本地检索与搜索。",
  "oneSentenceSummary": "Google 发布 EmbeddingGemma 2，这是一个 7.4 亿参数的模型，整合了文本、代码、图像、视频和音频嵌入，在其尺寸下实现了最佳性能，支持高效的本地检索与搜索。",
  "summary": "EmbeddingGemma 2 是 Google 推出的一款新型多模态嵌入模型，构建在 Gemma 4 架构上，采用 Apache 2.0 许可证发布。该模型拥有 7.4 亿参数，优化用于本地推理，支持最高 8K token 上下文，并采用 Matryoshka 表征学习实现存储高效的向量截断。在代码、视觉与音频基准测试中均取得顶级成绩，并与 Google AI Edge 工具集成，用于实时决策引擎与多媒体搜索应用。",
  "mainPoints": [
    {
      "point": "多模态统一",
      "explanation": "EmbeddingGemma 2 将文本、代码、图像、视频与音频整合到单一嵌入空间，支持跨模态搜索与检索。这对从语音备忘录中寻找特定视频片段或用文本查询搜索音频录音尤为有用。"
    },
    {
      "point": "专为本地端性能优化",
      "explanation": "模型设计运行在有限资源的消费级硬件上，文本任务仅需约 191MB 活跃内存，完整多模态模型也仅需约 567MB，适合边缘计算应用。"
    },
    {
      "point": "存储高效",
      "explanation": "采用 Matryoshka 表征学习（MRL），模型输出向量可动态从 768 维截断至 128 维，实现最多 6 倍的本地向量数据库存储降低，对低存储容量设备管理大型数据集至关重要。"
    },
    {
      "point": "高性能",
