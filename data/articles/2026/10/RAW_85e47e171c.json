  "content": "<html>\n <head></head>\n <body>\n  <div data-gu-name=\"media\" class=\"dcr-1u7kru9\">\n   <div>\n    <div class=\"dcr-1c5h9ao\">\n     <figure id=\"7f7393f5-73ca-44ac-a4c3-902f63ae32ea\" class=\"dcr-191xnya\">\n      <div id=\"img-1\" class=\"dcr-1t7hdmw\">\n       <picture class=\"dcr-up96pv\"><source srcset=\"https://i.guim.co.uk/img/media/6a654be294fa052899fd8b061483418b9cc7f121/0_17_1024_819/master/1024.jpg?width=620&amp;dpr=2&amp;s=none&amp;crop=none\" media=\"(min-width: 980px) and (-webkit-min-device-pixel-ratio: 1.25), (min-width: 980px) and (min-resolution: 120dpi)\"><source srcset=\"https://i.guim.co.uk/img/media/6a654be294fa052899fd8b061483418b9cc7f121/0_17_1024_819/master/1024.jpg?width=620&amp;dpr=1&amp;s=none&amp;crop=none\" media=\"(min-width: 980px)\"><source srcset=\"https://i.guim.co.uk/img/media/6a654be294fa052899fd8b061483418b9cc7f121/0_17_1024_819/master/1024.jpg?width=700&amp;dpr=2&amp;s=none&amp;crop=none\" media=\"(min-width: 740px) and (-webkit-min-device-pixel-ratio: 1.25), (min-width: 740px) and (min-resolution: 120dpi)\"><source srcset=\"https://i.guim.co.uk/img/media/6a654be294fa052899fd8b061483418b9cc7f121/0_17_1024_819/master/1024.jpg?width=700&amp;dpr=1&amp;s=none&amp;crop=none\" media=\"(min-width: 740px)\"><source srcset=\"https://i.guim.co.uk/img/media/6a654be294fa052899fd8b061483418b9cc7f121/0_17_1024_819/master/1024.jpg?width=620&amp;dpr=2&amp;s=none&amp;crop=none\" media=\"(min-width: 660px) and (-webkit-min-device-pixel-ratio: 1.25), (min-width: 660px) and (min-resolution: 120dpi)\"><source srcset=\"https://i.guim.co.uk/img/media/6a654be294fa052899fd8b061483418b9cc7f121/0_17_1024_819/master/1024.jpg?width=620&amp;dpr=1&amp;s=none&amp;crop=none\" media=\"(min-width: 660px)\"><source srcset=\"https://i.guim.co.uk/img/media/6a654be294fa052899fd8b061483418b9cc7f121/0_17_1024_819/master/1024.jpg?width=645&amp;dpr=2&amp;s=none&amp;crop=none\" media=\"(min-width: 480px) and (-webkit-min-device-pixel-ratio: 1.25), (min-width: 480px) and (min-resolution: 120dpi)\"><source srcset=\"https://i.guim.co.uk/img/media/6a654be294fa052899fd8b061483418b9cc7f121/0_17_1024_819/master/1024.jpg?width=645&amp;dpr=1&amp;s=none&amp;crop=none\" media=\"(min-width: 480px)\"><source srcset=\"https://i.guim.co.uk/img/media/6a654be294fa052899fd8b061483418b9cc7f121/0_17_1024_819/master/1024.jpg?width=465&amp;dpr=2&amp;s=none&amp;crop=none\" media=\"(min-width: 320px) and (-webkit-min-device-pixel-ratio: 1.25), (min-width: 320px) and (min-resolution: 120dpi)\"><source srcset=\"https://i.guim.co.uk/img/media/6a654be294fa052899fd8b061483418b9cc7f121/0_17_1024_819/master/1024.jpg?width=465&amp;dpr=1&amp;s=none&amp;crop=none\" media=\"(min-width: 320px)\"><img alt=\"Anne Carson portrait in which a black embroidered collared jacket can just be seen\" src=\"https://i.guim.co.uk/img/media/6a654be294fa052899fd8b061483418b9cc7f121/0_17_1024_819/master/1024.jpg?width=465&amp;dpr=1&amp;s=none&amp;crop=none\" loading=\"eager\" class=\"dcr-up96pv\"></picture><span class=\"dcr-kogzpx\"> \n        <div class=\"dcr-18mnkpm\">\n         <div class=\"dcr-1294qmb\">\n          <label for=\"the-checkbox\" class=\"dcr-4sl2vt\"> \n           <svg width=\"6\" height=\"14\" fill=\"white\" viewBox=\"0 0 6 14\">\n            <path d=\"M4.6 12l-.4 1.4c-.7.2-1.9.6-3 .6-.7 0-1.2-.2-1.2-.9 0-.2 0-.3.1-.5l2-6.7H.7l.4-1.5 4.2-.6h.2L3 12h1.6zm-.3-9.2c-.9 0-1.4-.5-1.4-1.3C2.9.5 3.7 0 4.6 0 5.4 0 6 .5 6 1.3c0 1-.8 1.5-1.7 1.5z\"></path>\n           </svg> \n          </label><input type=\"checkbox\" id=\"the-checkbox\">\n          <div id=\"the-caption\">\n           <figcaption data-spacefinder-role=\"inline\" class=\"dcr-1mfxiaj\">\n            <span class=\"dcr-13i4yc9\"> \n             <svg width=\"18\" height=\"13\" viewBox=\"0 0 18 13\">\n              <path d=\"M18 3.5v8l-1.5 1.5h-15l-1.5-1.5v-8l1.5-1.5h3.5l2-2h4l2 2h3.5l1.5 1.5zm-9 7.5c1.9 0 3.5-1.6 3.5-3.5s-1.6-3.5-3.5-3.5-3.5 1.6-3.5 3.5 1.6 3.5 3.5 3.5z\"></path>\n             </svg> \n            </span><span class=\"dcr-1cipnsy\">The academy cited Anne Carson’s ‘bold and inventive oeuvre’ in its awarding of the prize.</span>\n           </figcaption>\n          </div>\n         </div>\n        </div> \n       </span>\n      </div>\n      <span class=\"dcr-qda0hp\"> \n       <figcaption data-spacefinder-role=\"inline\" class=\"dcr-1e9iiy9\">\n        <span class=\"dcr-13i4yc9\"> \n         <svg width=\"18\" height=\"13\" viewBox=\"0 0 18 13\">\n          <path d=\"M18 3.5v8l-1.5 1.5h-15l-1.5-1.5v-8l1.5-1.5h3.5l2-2h4l2 2h3.5l1.5 1.5zm-9 7.5c1.9 0 3.5-1.6 3.5-3.5s-1.6-3.5-3.5-3.5-3.5 1.6-3.5 3.5 1.6 3.5 3.5 3.5z\"></path>\n         </svg> \n        </span><span class=\"dcr-1cipnsy\">The academy cited Anne Carson’s ‘bold and inventive oeuvre’ in its awarding of the prize.</span>\n       </figcaption> \n      </span>\n     </figure>\n    </div>\n   </div>\n  </div>\n  <aside data-gu-name=\"title\" class=\"dcr-u4wzdg\">\n   <div class=\"dcr-4vvq0s\">\n    <div class=\"dcr-0\">\n     <span class=\"dcr-c2pk3s\"></span><a href=\"https://www.theguardian.com/books/nobel-prize-literature\" data-component=\"section\" data-link-name=\"article section\" class=\"content__label__link dcr-b3hcnl\"><span>Nobel prize in literature</span></a>\n    </div>\n   </div>\n  </aside>\n  <div data-gu-name=\"headline\" class=\"dcr-4pptvk\">\n   <div class=\"dcr-6mja0y\"></div>\n  </div>\n  <div data-gu-name=\"standfirst\" class=\"dcr-47amn7\">\n   <div class=\"dcr-8q9fjy\">\n    <p>Most prestigious literature prize goes to Canadian known for genre-crossing works such as Autobiography of Red</p>\n   </div>\n  </div>\n  <aside data-gu-name=\"meta\" class=\"dcr-9vi26e\">\n   <div class=\"dcr-u9k4zf\"></div>\n   <div class=\"dcr-18aucbd\">\n    <div class=\"dcr-vyk1vu\">\n     <div class=\"dcr-19o5mbt\">\n      <div>\n       <address data-component=\"meta-byline\" data-link-name=\"byline\" data-gu-name=\"byline\">\n        <div class=\"dcr-15wyqgv\">\n         <a rel=\"author\" data-link-name=\"auto tag link\" href=\"https://www.theguardian.com/profile/emma-loffhagen\">Emma Loffhagen</a><span> and </span><a rel=\"author\" data-link-name=\"auto tag link\" href=\"https://www.theguardian.com/profile/leyland-cecco\">Leyland Cecco</a><span> in Toronto</span>\n        </div>\n       </address>\n       <details style=\"--mobile-colour:var(--dateline)\" data-gu-name=\"dateline\" class=\"dcr-kzowyp\">\n        <summary class=\"dcr-njvsm3\"><span class=\"dcr-10i63lj\">Thu 8 Oct 2026 10.03 EDT</span></summary>First published on Thu 8 Oct 2026 07.02 EDT\n       </details>\n      </div>\n     </div>\n     <div data-print-layout=\"hide\" style=\"margin-bottom:8px\" class=\"dcr-wk3oiu\">\n      <div class=\"dcr-h34qpb\" style=\"padding-top:8px\">\n       <gu-island name=\"ShareButton\" priority=\"feature\" deferuntil=\"visible\" props=\"{&quot;pageId&quot;:&quot;books/2026/oct/08/wins-the-nobel-prize-in-literature-2026&quot;,&quot;webTitle&quot;:&quot;Anne Carson wins Nobel prize in literature 2026&quot;,&quot;format&quot;:{&quot;design&quot;:0,&quot;display&quot;:0,&quot;theme&quot;:3},&quot;context&quot;:&quot;ArticleMeta&quot;}\"><a href=\"mailto:?subject=Anne Carson wins Nobel prize in literature 2026&amp;body=https://www.theguardian.com/books/2026/oct/08/wins-the-nobel-prize-in-literature-2026?CMP=share_btn_url\" type=\"button\" class=\"dcr-ncybeu\">Share</a></gu-island>\n      </div>\n      <div class=\"dcr-6fc8w\">\n       <div class=\"dcr-35oohv\"></div>\n      </div>\n     </div>\n     <a href=\"https://www.google.com/preferences/source?q=theguardian.com\" data-component=\"preferred-source-button-prefer\" data-link-name=\"preferred-source-button-prefer\" class=\"dcr-j63hn9\">Prefer the Guardian on Google</a>\n    </div>\n   </div>\n  </aside>\n  <div data-gu-name=\"body\" class=\"dcr-13wig6c\">\n   <div class=\"dcr-11gq2tx\">\n    <div id=\"maincontent\" class=\"dcr-1w2vkyc\">\n     <div class=\"article-body-commercial-selector article-body-viewer-selector dcr-1p3m4i4\">\n      <p class=\"dcr-1s160rg\">The <a href=\"https://www.theguardian.com/books/nobel-prize-literature\" data-link-name=\"in body link\" data-component=\"auto-linked-tag\">Nobel prize in literature</a> has been awarded to the Canadian poet and essayist Anne Carson, the Swedish Academy has announced.</p>\n      <p class=\"dcr-1s160rg\">The academy cited the author’s “bold and inventive oeuvre that, in playful dialogue with the classical tradition, has created new forms for contemporary literature”.</p>\n      <p class=\"dcr-1s160rg\">The Nobel prize, regarded as the most prestigious award in global literature, is awarded for a lifetime’s body of work. The winner receives 12m Swedish kronor (£900,000).</p>\n      <p class=\"dcr-1s160rg\">Ingrid Carlberg, the permanent secretary of the Swedish Academy, said she told Carson of the news on the phone shortly before the news broke. “She had time to tell me that she is, for the moment, in Iceland, where she is listening to the wind,” Carlberg said. “She was taken by surprise but very happy. I could hear that in her voice.”</p>\n      <figure id=\"2f4c8b3c-4110-4f8b-b7f5-e71159bd858e\" data-spacefinder-role=\"inline\" data-spacefinder-type=\"model.dotcomrendering.pageElements.ImageBlockElement\" class=\"dcr-d9bay7\">\n       <div id=\"img-2\" class=\"dcr-1t7hdmw\">\n        <picture class=\"dcr-up96pv\"><source srcset=\"https://i.guim.co.uk/img/media/efe7e7e4803fe68c055898af047c6123e77950f2/0_0_5712_3808/master/5712.jpg?width=620&amp;dpr=2&amp;s=none&amp;crop=none\" media=\"(min-width: 660px) and (-webkit-min-device-pixel-ratio: 1.25), (min-width: 660px) and (min-resolution: 120dpi)\"><source srcset=\"https://i.guim.co.uk/img/media/efe7e7e4803fe68c055898af047c6123e77950f2/0_0_5712_3808/master/5712.jpg?width=620&amp;dpr=1&amp;s=none&amp;crop=none\" media=\"(min-width: 660px)\"><source srcset=\"https://i.guim.co.uk/img/media/efe7e7e4803fe68c055898af047c6123e77950f2/0_0_5712_3808/master/5712.jpg?width=605&amp;dpr=2&amp;s=none&amp;crop=none\" media=\"(min-width: 480px) and (-webkit-min-device-pixel-ratio: 1.25), (min-width: 480px) and (min-resolution: 120dpi)\"><source srcset=\"https://i.guim.co.uk/img/media/efe7e7e4803fe68c055898af047c6123e77950f2/0_0_5712_3808/master/5712.jpg?width=605&amp;dpr=1&amp;s=none&amp;crop=none\" media=\"(min-width: 480px)\"><source srcset=\"https://i.guim.co.uk/img/media/efe7e7e4803fe68c055898af047c6123e77950f2/0_0_5712_3808/master/5712.jpg?width=445&amp;dpr=2&amp;s=none&amp;crop=none\" media=\"(min-width: 320px) and (-webkit-min-device-pixel-ratio: 1.25), (min-width: 320px) and (min-resolution: 120dpi)\"><source srcset=\"https://i.guim.co.uk/img/media/efe7e7e4803fe68c055898af047c6123e77950f2/0_0_5712_3808/master/5712.jpg?width=445&amp;dpr=1&amp;s=none&amp;crop=none\" media=\"(min-width: 320px)\"><img alt=\"Anne Carson books arranged on a shelf\" src=\"https://i.guim.co.uk/img/media/efe7e7e4803fe68c055898af047c6123e77950f2/0_0_5712_3808/master/5712.jpg?width=445&amp;dpr=1&amp;s=none&amp;crop=none\" loading=\"lazy\" class=\"dcr-up96pv\"></picture>\n       </div>\n       <figcaption data-spacefinder-role=\"inline\" class=\"dcr-174mzkf\">\n        <span class=\"dcr-vyhg7z\"> \n         <svg width=\"18\" height=\"13\" viewBox=\"0 0 18 13\">\n          <path d=\"M18 3.5v8l-1.5 1.5h-15l-1.5-1.5v-8l1.5-1.5h3.5l2-2h4l2 2h3.5l1.5 1.5zm-9 7.5c1.9 0 3.5-1.6 3.5-3.5s-1.6-3.5-3.5-3.5-3.5 1.6-3.5 3.5 1.6 3.5 3.5 3.5z\"></path>\n         </svg> \n        </span><span class=\"dcr-1cipnsy\">Books by Anne Carson on display at a Waterstones bookshop in London.</span> Photograph: Hannah McKay/Reuters\n       </figcaption>\n      </figure>\n      <p class=\"dcr-1s160rg\">Born in Toronto in 1950, Carson is known for <a href=\"https://www.nobelprize.org/prizes/literature/2026/bio-bibliography/\" data-link-name=\"in body link\">work that moves freely between poetry, prose and translation</a>, drawing heavily on the literature and mythology of the ancient Greek world. She has been a professor of classics at various institutions including Princeton, New York University and McGill University in Montreal. She is the 19th woman to win, out of 123 literature laureates.</p>\n      <p class=\"dcr-1s160rg\">Carson’s first book, Eros the Bittersweet, was published in 1986 and combined literary criticism with an exploration of desire and the ancient Greek tradition.</p>\n      <p class=\"dcr-1s160rg\">Her best-known work is Autobiography of Red, a 1998 novel in verse inspired by the fragments of the ancient Greek poet Stesichorus. It reimagines the myth of Geryon, the red-winged monster killed by Herakles, as the story of a modern teenage boy navigating heartbreak and desire.</p>\n      <p class=\"dcr-1s160rg\">In 2001, she became the first woman to win the TS Eliot prize, for her collection The Beauty of the Husband. She has also been awarded Guggenheim and MacArthur fellowships.</p>\n      <p class=\"dcr-1s160rg\">David Leonard, the executive director of the Writers’ Trust of <a href=\"https://www.theguardian.com/world/canada\" data-link-name=\"in body link\" data-component=\"auto-linked-tag\">Canada</a>, said: “Anne is such a brilliant writer. Her work is broad, but also extremely smart.” Calling Carson’s work “intoxicating”, he said her four-decade career had resulted in a peerless collection of poems and essays. “They’re beautiful, they’re smart, they’re true and they are humane. It’s exactly what we need in our writing.”</p>\n      <p class=\"dcr-1s160rg\">Carson’s work has attracted praise from fellow writers including Susan Sontag, who once said: “She is one of the few writers writing in English that I would read anything she wrote. If there’s a magazine that has something of hers in it, I buy it automatically.”</p>\n      <figure id=\"3ab78ab9-666b-433a-a98f-d4a1c1919694\" data-spacefinder-role=\"inline\" data-spacefinder-type=\"model.dotcomrendering.pageElements.ImageBlockElement\" class=\"dcr-d9bay7\">\n       <div id=\"img-3\" class=\"dcr-1t7hdmw\">\n        <picture class=\"dcr-up96pv\"><source srcset=\"https://i.guim.co.uk/img/media/082a75ad6d679079f5d79bc78508e8947d7d47c5/0_0_8256_5504/master/8256.jpg?width=620&amp;dpr=2&amp;s=none&amp;crop=none\" media=\"(min-width: 660px) and (-webkit-min-device-pixel-ratio: 1.25), (min-width: 660px) and (min-resolution: 120dpi)\"><source srcset=\"https://i.guim.co.uk/img/media/082a75ad6d679079f5d79bc78508e8947d7d47c5/0_0_8256_5504/master/8256.jpg?width=620&amp;dpr=1&amp;s=none&amp;crop=none\" media=\"(min-width: 660px)\"><source srcset=\"https://i.guim.co.uk/img/media/082a75ad6d679079f5d79bc78508e8947d7d47c5/0_0_8256_5504/master/8256.jpg?width=605&amp;dpr=2&amp;s=none&amp;crop=none\" media=\"(min-width: 480px) and (-webkit-min-device-pixel-ratio: 1.25), (min-width: 480px) and (min-resolution: 120dpi)\"><source srcset=\"https://i.guim.co.uk/img/media/082a75ad6d679079f5d79bc78508e8947d7d47c5/0_0_8256_5504/master/8256.jpg?width=605&amp;dpr=1&amp;s=none&amp;crop=none\" media=\"(min-width: 480px)\"><source srcset=\"https://i.guim.co.uk/img/media/082a75ad6d679079f5d79bc78508e8947d7d47c5/0_0_8256_5504/master/8256.jpg?width=445&amp;dpr=2&amp;s=none&amp;crop=none\" media=\"(min-width: 320px) and (-webkit-min-device-pixel-ratio: 1.25), (min-width: 320px) and (min-resolution: 120dpi)\"><source srcset=\"https://i.guim.co.uk/img/media/082a75ad6d679079f5d79bc78508e8947d7d47c5/0_0_8256_5504/master/8256.jpg?width=445&amp;dpr=1&amp;s=none&amp;crop=none\" media=\"(min-width: 320px)\"><img alt=\"Ingrid Carlberg smiling while announcing the winner in an ornate room\" src=\"https://i.guim.co.uk/img/media/082a75ad6d679079f5d79bc78508e8947d7d47c5/0_0_8256_5504/master/8256.jpg?width=445&amp;dpr=1&amp;s=none&amp;crop=none\" loading=\"lazy\" class=\"dcr-up96pv\"></picture>\n       </div>\n       <figcaption data-spacefinder-role=\"inline\" class=\"dcr-174mzkf\">\n        <span class=\"dcr-vyhg7z\"> \n         <svg width=\"18\" height=\"13\" viewBox=\"0 0 18 13\">\n          <path d=\"M18 3.5v8l-1.5 1.5h-15l-1.5-1.5v-8l1.5-1.5h3.5l2-2h4l2 2h3.5l1.5 1.5zm-9 7.5c1.9 0 3.5-1.6 3.5-3.5s-1.6-3.5-3.5-3.5-3.5 1.6-3.5 3.5 1.6 3.5 3.5 3.5z\"></path>\n         </svg> \n        </span><span class=\"dcr-1cipnsy\">Ingrid Carlberg announcing Anne Carson as the recipient of the 2026 Nobel prize in literature in Stockholm on Thursday.</span> Photograph: Christine Olsson/EPA\n       </figcaption>\n      </figure>\n      <p class=\"dcr-1s160rg\">Anders Olsson, the chair of the Swedish Academy’s Nobel Committee for Literature, praised Carson for work that had “broken away from lyrical poetry bound to the narrative self and inspired new forms of contemporary literature”. He said: “This method of writing leads to playful and ironic works that move not only between classical and modern poetry but also between different genres and artforms.”</p>\n      <p class=\"dcr-1s160rg\">Carson’s books have ranged widely in form. Men in the Off Hours combined verse essays, poems, epitaphs and prose about artists and historical figures, and won the inaugural Griffin poetry prize in 2001. Decreation, another eclectic work, brought together poetry, essays and an opera.</p>\n      <p class=\"dcr-1s160rg\">Nox, published in 2010, is particularly characteristic of Carson’s avant-garde approach to literature – the book takes the form of an accordion-fold box containing a reproduction of a notebook Carson made after the death of her brother. Her later works include Red Doc&gt; and Float.</p>\n      <p class=\"dcr-1s160rg\">In a <a href=\"https://www.theguardian.com/books/2013/aug/16/red-doc-anne-carson-review\" data-link-name=\"in body link\">Guardian review</a> of Red Doc&gt;, Sarah Crown wrote: “To engage so fluidly, so originally and compellingly, with a story first told more than 3,000 years ago, is astonishing: her ambition is one thing; the fact that it is so completely achieved is, frankly, something else.”</p>\n      <p class=\"dcr-1s160rg\">Much of Carson’s work has emerged from her fascination with language itself. The Swedish Academy noted: “Almost all her literary production has centred upon the intersection between the philologist’s obsession with words and the poet’s desire for new meaning,” adding that Carson had identified the etymology of words as “the starting point for all her work”.</p>\n      <p class=\"dcr-1s160rg\">Asked why she continually moved between forms, Carson said in an interview: “Boredom I guess. There is a restlessness. There are a lot of forms to try.”</p>\n      <p class=\"dcr-1s160rg\">She has acknowledged the difficulties that come with her experimental style. “[My work] does fall apart a lot,” she said in a 2018 interview. “It gets just too weird for anyone to care about reading, or else it gets diluted into a sort of parody of itself.”</p>\n      <p class=\"dcr-1s160rg\">Ira Wells, the president of PEN Canada, said Carson’s win “feels particularly significant at a moment in which Canada and Europe are strengthening cultural ties amidst broader global disruption. And, on an aesthetic level, Carson’s verse vibrates on profound human frequencies, at a moment in which more and more language is formulated by machines.”</p>\n      <p class=\"dcr-1s160rg\">Carson has generally kept her personal life out of interviews. However, in an August 2024 article for the London Review of Books, she disclosed that she had been diagnosed with Parkinson’s disease.</p>\n      <p class=\"dcr-1s160rg\">The Nobel prize in literature has been awarded on 118 previous occasions since 1901. Recent laureates include Annie Ernaux, Bob Dylan, Abdulrazak Gurnah, Louise Glück, Peter Handke and Olga Tokarczuk. Last year’s recipient was the Hungarian author László Krasznahorkai, known for his dystopic and avant-garde writing.</p>\n      <p class=\"dcr-1s160rg\">Carson, 76, will formally receive the medal and diploma in a ceremony in Stockholm in December.</p>\n      <ul class=\"dcr-1s160rg\">\n       <li class=\"dcr-1s160rg\">\n        <p class=\"dcr-1s160rg\">To browse works by Anne Carson, visit <a href=\"https://guardianbookshop.com/search.php?search_query=anne+carson&amp;utm_source=editoriallink&amp;utm_medium=merch&amp;utm_campaign=article\" data-link-name=\"in body link\">guardianbookshop.com</a>. Delivery charges may apply.</p>\n       </li>\n      </ul>\n     </div>\n    </div>\n    <gu-island name=\"SlotBodyEnd\" priority=\"feature\" deferuntil=\"visible\" props=\"{&quot;contentType&quot;:&quot;Article&quot;,&quot;contributionsServiceUrl&quot;:&quot;https://contributions.guardianapis.com&quot;,&quot;idApiUrl&quot;:&quot;https://idapi.theguardian.com&quot;,&quot;isPaidContent&quot;:false,&quot;pageId&quot;:&quot;books/2026/oct/08/wins-the-nobel-prize-in-literature-2026&quot;,&quot;sectionId&quot;:&quot;books&quot;,&quot;shouldHideReaderRevenue&quot;:false,&quot;tags&quot;:[{&quot;id&quot;:&quot;books/nobel-prize-literature&quot;,&quot;type&quot;:&quot;Keyword&quot;,&quot;title&quot;:&quot;Nobel prize in literature&quot;},{&quot;id&quot;:&quot;books/anne-carson&quot;,&quot;type&quot;:&quot;Keyword&quot;,&quot;title&quot;:&quot;Anne Carson&quot;},{&quot;id&quot;:&quot;books/fiction&quot;,&quot;type&quot;:&quot;Keyword&quot;,&quot;title&quot;:&quot;Fiction&quot;},{&quot;id&quot;:&quot;books/poetry&quot;,&quot;type&quot;:&quot;Keyword&quot;,&quot;title&quot;:&quot;Poetry&quot;},{&quot;id&quot;:&quot;culture/awards-and-prizes&quot;,&quot;type&quot;:&quot;Keyword&quot;,&quot;title&quot;:&quot;Awards and prizes&quot;},{&quot;id&quot;:&quot;books/books&quot;,&quot;type&quot;:&quot;Keyword&quot;,&quot;title&quot;:&quot;Books&quot;},{&quot;id&quot;:&quot;culture/culture&quot;,&quot;type&quot;:&quot;Keyword&quot;,&quot;title&quot;:&quot;Culture&quot;},{&quot;id&quot;:&quot;world/canada&quot;,&quot;type&quot;:&quot;Keyword&quot;,&quot;title&quot;:&quot;Canada&quot;},{&quot;id&quot;:&quot;world/americas&quot;,&quot;type&quot;:&quot;Keyword&quot;,&quot;title&quot;:&quot;Americas&quot;