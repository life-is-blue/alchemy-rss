  "content": "<html>\n <head></head>\n <body>\n  <div id=\"pjax-well\" class=\"container page-content-area\">\n   <div class=\"pjax-container\">\n    <section class=\"page-section biographical\">\n     <aside class=\"page-aside border-top\">\n      <div class=\"page-aside__wrapper\">\n       <header class=\"header\"></header>\n       <nav class=\"aside-navigation aside-navigation--desktop\" aria-label=\"In Page Navigation\">\n        <ul class=\"aside-navigation__list\">\n         <li class=\"aside-navigation__list-item\"><a href=\"https://www.nobelprize.org/prizes/medicine/2026/summary/\" aria-current=\"false\"> Summary </a></li>\n         <li class=\"aside-navigation__list-item\">Laureates\n          <ul class=\"aside-navigation__list\">\n           <li class=\"aside-navigation__list-item\">Karl Deisseroth\n            <ul class=\"aside-navigation__list\">\n             <li class=\"aside-navigation__list-item\"><a href=\"https://www.nobelprize.org/prizes/medicine/2026/deisseroth/facts/\" aria-current=\"false\"> Facts </a></li>\n             <li class=\"aside-navigation__list-item\"><a href=\"https://www.nobelprize.org/prizes/medicine/2026/deisseroth/interview/\" aria-current=\"false\"> Interview </a></li>\n             <li class=\"aside-navigation__list-item\"><a href=\"https://www.nobelprize.org/prizes/medicine/2026/deisseroth/photo-gallery/\" aria-current=\"false\"> Photo gallery </a></li>\n             <li class=\"aside-navigation__list-item\"><a href=\"https://www.nobelprize.org/prizes/medicine/2026/deisseroth/other-resources/\" aria-current=\"false\"> Other resources </a></li>\n            </ul></li>\n           <li class=\"aside-navigation__list-item\"><a href=\"https://www.nobelprize.org/prizes/medicine/2026/hegemann/facts/\" aria-current=\"false\"> Peter Hegemann </a></li>\n           <li class=\"aside-navigation__list-item\"><a href=\"https://www.nobelprize.org/prizes/medicine/2026/nagel/facts/\" aria-current=\"false\"> Georg Nagel </a></li>\n          </ul></li>\n         <li class=\"aside-navigation__list-item\"><a href=\"https://www.nobelprize.org/prizes/medicine/2026/prize-announcement/\" aria-current=\"false\"> Prize announcement </a></li>\n         <li class=\"aside-navigation__list-item\"><a href=\"https://www.nobelprize.org/prizes/medicine/2026/press-release/\" aria-current=\"false\"> Press release </a></li>\n         <li class=\"aside-navigation__list-item\"><a href=\"https://www.nobelprize.org/prizes/medicine/2026/popular-information/\" aria-current=\"false\"> Popular information </a></li>\n         <li class=\"aside-navigation__list-item\"><a href=\"https://www.nobelprize.org/prizes/medicine/2026/advanced-information/\" aria-current=\"false\"> Advanced information </a></li>\n        </ul>\n       </nav>\n       <footer class=\"footer\">\n        <div class=\"share-this\">\n         <h2 class=\"h6\">Share this</h2>\n         <ul class=\"socialicons\" aria-label=\"Social sharing links\">\n          <li class=\"socialicon\" data-social=\"facebook\"><a href=\"https://www.facebook.com/sharer.php?u=https%3A%2F%2Fwww.nobelprize.org%2Fprizes%2Fmedicine%2F2026%2Fdeisseroth%2Finterview%2F&amp;t=Karl+Deisseroth+%E2%80%93+Interview\" data-target=\"https://www.nobelprize.org/prizes/medicine/2026/deisseroth/interview/\" target=\"_blank\" rel=\"noreferrer\"> \n            <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"40\" height=\"40\" viewBox=\"0 0 40 40\">\n             <path d=\"M14.526 34h-3.96A4.572 4.572 0 0 1 6 29.43V10.57C6 8.051 8.051 6 10.571 6H29.43A4.577 4.577 0 0 1 34 10.57v18.854c0 2.52-2.051 4.57-4.571 4.57h-3.492a.573.573 0 0 1-.571-.571V22.305c0-.314.257-.571.571-.571h2.229l.405-3.228h-2.634a.573.573 0 0 1-.571-.571v-3.28c0-.314.257-.57.571-.57h2.709v-3.229h-4.892a1.62 1.62 0 0 0-1.617 1.617v5.462a.573.573 0 0 1-.571.571h-2.709v3.228h2.709c.314 0 .571.257.571.571v11.118a.59.59 0 0 1-.166.406c-.148.148-.171.171-7.44.171h-.005ZM10.57 7.143a3.43 3.43 0 0 0-3.428 3.427v18.854a3.43 3.43 0 0 0 3.423 3.428