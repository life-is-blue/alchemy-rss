ize.org/cdn-cgi/l/email-protection#\" target=\"_blank\" rel=\"noreferrer\"> \n            <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"40\" height=\"40\" viewBox=\"0 0 40 40\">\n             <path fill-rule=\"evenodd\" d=\"M12.229 14.02A1.37 1.37 0 0 0 11 15.384v9.84a1.37 1.37 0 0 0 1.37 1.37h15.26a1.37 1.37 0 0 0 1.37-1.37V15.37A1.37 1.37 0 0 0 27.63 14H12.37a.5.5 0 0 0-.141.02Zm.256.98a.504.504 0 0 1-.114.013.37.37 0 0 0-.371.37v9.841a.37.37 0 0 0 .37.37h15.26a.37.37 0 0 0 .37-.37V15.37a.37.37 0 0 0-.37-.37H12.485Zm.288.88a.5.5 0 0 1 .699-.107L20 20.577l6.528-4.804a.5.5 0 0 1 .593.805l-6.825 5.023a.5.5 0 0 1-.592 0l-6.825-5.023a.5.5 0 0 1-.106-.699Z\" clip-rule=\"evenodd\" /><path fill-rule=\"evenodd\" d=\"M28.857 6H11.143A5.148 5.148 0 0 0 6 11.143v17.714A5.148 5.148 0 0 0 11.143 34h17.714A5.148 5.148 0 0 0 34 28.857V11.143A5.148 5.148 0 0 0 28.857 6Zm4 22.857c0 2.205-1.795 4-4 4H11.143c-2.205 0-4-1.795-4-4V11.143c0-2.205 1.795-4 4-4h17.714c2.205 0 4 1.795 4 4v17.714Z\" clip-rule=\"evenodd\" />\n            </svg> \n            <span class=\"screen-reader-text\"> Email this page </span> \n           </a></li>\n         </ul>\n        </div>\n       </footer>\n      </div>\n     </aside>\n     <article class=\"  page-content border-top entry-content\">\n      <header class=\"section-header\">\n       <h1>Karl Deisseroth</h1>\n       <h2>Interview</h2>\n      </header>\n      <select class=\"aside-navigation aside-navigation--mobile input-select js-aside-navigation--mobile\" name=\"Go to laureate page\"> <option value=\"\" selected disabled>Navigate to:</option> <option value=\"https://www.nobelprize.org/prizes/medicine/2026/summary/\"> Summary</option><optgroup label=\" Laureates\"></optgroup><optgroup label=\"- Karl Deisseroth\"><option value=\"https://www.nobelprize.org/prizes/medicine/2026/deisseroth/facts/\">-- Facts</option><option value=\"https://www.nobelprize.org/prizes/medicine/2026/deisseroth/interview/\" disabled selected>-- Interview</option><option value=\"https://www.nobelprize.org/prizes/medicine/2026/deisseroth/photo-gallery/\">-- Photo gallery</option><option value=\"https://www.nobelprize.org/prizes/medicine/2026/deisseroth/other-resources/\">-- Other resources</option></optgroup><option value=\"https://www.nobelprize.org/prizes/medicine/2026/hegemann/facts/\">- Peter Hegemann</option><option value=\"https://www.nobelprize.org/prizes/medicine/2026/nagel/facts/\">- Georg Nagel</option><option value=\"https://www.nobelprize.org/prizes/medicine/2026/prize-announcement/\"> Prize announcement</option><option value=\"https://www.nobelprize.org/prizes/medicine/2026/press-release/\"> Press release</option><option value=\"https://www.nobelprize.org/prizes/medicine/2026/popular-information/\"> Popular information</option><option value=\"https://www.nobelprize.org/prizes/medicine/2026/advanced-information/\"> Advanced information</option></select>\n      <h2 class=\"wp-block-heading\">First reactions. Telephone interview with Karl Deisseroth, October 2026</h2>\n      <figure class=\"wp-block-embed is-type-video is-provider-youtube wp-block-embed-youtube wp-embed-aspect-16-9 wp-has-aspect-ratio\">\n       <div class=\"wp-block-embed__wrapper\">\n        <div class=\"iframe iframe-16x9\">\n         <iframe title=\"First reactions | Karl Deisseroth, Nobel Prize in Physiology or Medicine | telephone interview\" width=\"1778\" height=\"1000\" src=\"https://www.youtube.com/embed/RNogbM246cE?feature=oembed\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen></iframe>\n        </div>\n       </div>\n      </figure>\n      <h3 class=\"wp-block-heading\">“So much mystery now finally seems on the brink of elucidation”</h3>\n      <div class=\"wp-block-columns is-layout-flex wp-container-core-columns-is-layout-28f84493 wp-block-columns-is-layout-flex\">\n       <div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\">\n        <p>Karl Deisseroth was working on a paper, late into the night, and had just gone to bed when the call came from Stockholm breaking the news that he had been awarded the 2026 Nobel Prize in Physiology or Medicine. In this interview, recorded while the rest of the household slept, he reflects on the possibilities for unravelling the mysteries of the brain that optogenetics is opening up.</p>\n       </div>\n       <div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\">\n        <figure class=\"wp-block-image alignright size-large\">\n         <img decoding=\"async\" src=\"https://www.nobelprize.org/images//195231-landscape-x-large.jpg\" alt=\"Deisseroth.jpg\" class=\"wp-image-1930421\">\n         <figcaption class=\"wp-element-caption\">\n          Karl Deisseroth shortly after learning about his Nobel Prize.&nbsp;<span class=\"image-credits\">Photo: Michelle Monje-Deisseroth</span>\n         </figcaption>\n        </figure>\n       </div>\n      </div>\n      <div data-wp-context=\"{ &quot;autoclose&quot;: false, &quot;accordionItems&quot;: [] }\" data-wp-interactive=\"core/accordion\" role=\"group\" class=\"wp-block-accordion is-layout-flow wp-block-accordion-is-layout-flow\">\n       <div data-wp-class--is-open=\"state.isOpen\" data-wp-context=\"{ &quot;id&quot;: &quot;accordion-item-1&quot;, &quot;openByDefault&quot;: false }\" data-wp-init=\"callbacks.initAccordionItems\" data-wp-on-window--hashchange=\"callbacks.hashChange\" class=\"wp-block-accordion-item is-layout-flow wp-block-accordion-item-is-layout-flow\">\n        <h3 class=\"wp-block-accordion-heading\">\n         <button aria-expanded=\"false\" aria-controls=\"accordion-item-1-panel\" data-wp-bind--aria-expanded=\"state.isOpen\" data-wp-on--click=\"actions.toggle\" data-wp-on--keydown=\"actions.handleKeyDown\" id=\"accordion-item-1\" type=\"button\" class=\"wp-block-accordion-heading__toggle\"><span class=\"wp-block-accordion-heading__toggle-title\">Interview transcript</span></button>\n        </h3>\n        <div inert aria-labelledby=\"accordion-item-1\" data-wp-bind--inert=\"!state.isOpen\" id=\"accordion-item-1-panel\" role=\"region\" class=\"wp-block-accordion-panel is-layout-flow wp-block-accordion-panel-is-layout-flow\">\n         <p>Karl Deisseroth:&nbsp;Hello?&nbsp;</p>\n         <p>Adam Smith:&nbsp;Hello. Am I speaking with Karl Deisseroth?&nbsp;</p>\n         <p>KD:&nbsp;Yes. Hi, this is Karl.&nbsp;</p>\n         <p>AS:&nbsp;Hi. This is Adam Smith calling from the website of the Nobel Prize in Stockholm. First of all, many congratulations.&nbsp;</p>\n         <p>KD:&nbsp;Thank you. It’s an incredible honour and unexpected, but I’m deeply honoured.&nbsp;</p>\n         <p>AS:&nbsp;It caught you in the middle of the night. What were you doing when the call came?&nbsp;</p>\n         <p>KD:&nbsp;I tend to work late, and so I had been working on a paper and I had just gone in to lay down when the call came, so I was not yet asleep being a night owl. And now I don’t think I’ll be able to sleep for quite a while.&nbsp;</p>\n         <p>AS:&nbsp;Oh goodness, I imagine you need your sleep because you balance so much. You balance your research, your teaching, your practice, and a house full of kids.&nbsp;&nbsp;</p>\n         <p>KD:&nbsp;That’s right, yes. The kids are all still asleep. You’re right, but most important, they need to sleep even more than I do. It’s a difficult balance, but it’s uplifting as well.&nbsp;</p>\n         <p>AS:&nbsp;Indeed. Well, let’s hope they sleep through the night, at least for a while, although I imagine people will be arriving at the house. How do you think the night’s going to unfold?&nbsp;&nbsp;</p>\n         <p>KD:&nbsp;Well, we’re going to let the kids sleep and I’m going to have a few moments of quiet and thinking about all the work we’ve put in. All the trainees and staff and collaborators around the world who have been so important. I’ll be thinking about them and the gratitude for all they’ve done together. And it’s a moment to just take a breath and look back and then look to the future to see where we can go from here.&nbsp;</p>\n         <p>AS:&nbsp;It’s an extraordinary technique, optogenetics, which is revealing all sorts of things by being able to switch on and off nerve cells in living systems. Could you just tell me one favourite relationship that has been revealed? One thing we understand now that we couldn’t understand before?&nbsp;</p>\n         <p>KD:&nbsp;One thing that has been so important to neuroscience and for complex biological systems to provide the precision of a gain and loss of function, that precision now can be applied to the activity of particular cells even within living animals. And one of the favourite examples of that in recent time, was we were able to, precisely pace the heart and look at effects that different heart rates have on brain states. So, communication across the body, from the body to the brain, but with the precision of a gain of function in a peripheral organ, allowing us to see the effects on, brain and behavioral states that relate to complex decision making and neuropsychiatric disorders. This ability to execute a precision intervention in one organ and to read out the effects and complex behaviors that come from that precision intervention, is something that people have wanted for a long time. To be able to provide these causal perturbations, that are precise and that are informative. And there’s so many questions for basic science, as well as for how things go wrong in disease states. As a psychiatrist, for me that’s also very important because so much mystery, now finally seems on the brink of elucidation.&nbsp;</p>\n         <p>AS:&nbsp;As you mentioned, you are a psychiatrist and so you continue to see patients.&nbsp;&nbsp;</p>\n         <p>KD:&nbsp;Yes.&nbsp;&nbsp;</p>\n         <p>AS:&nbsp;What does that bring to you, to your work, the fact that you talk to people suffering from mental illness of all sorts?&nbsp;</p>\n         <p>KD:&nbsp;For me, it’s a constant source of new perspective and a connection to what actually matters to people who most need help, and who are most misunderstood. For me, when I see patients and I hear them expressing in their subjective sense, in their subjective words, conveying this inner sense they have of these altered states that are so disruptive and so debilitating, I know that these are hard to express even for people experiencing them and often, very, very hard to study. For me, seeing what actually matters to the patients has helped me. It helps me in a continuous fashion in designing experiments in the laboratory, talking to students, being able to convey what actually matters in an altered state in the human brain.&nbsp;</p>\n         <p>AS:&nbsp;I know that you’re very keen on public understanding and there’s a stigma around mental illness, which is wrong. I suppose the Nobel Prize in some ways provides a platform for reducing the stigma.&nbsp;</p>\n         <p>KD:&nbsp;I think it certainly could and will. And I also look for opportunities to share the fact that every psychiatric disorder to some extent exists on a spectrum, and that there are aspects of these altered states that are rooted deep in our evolutionary history. These states are present because aspects of them in one way or another, or genes contributing to them, serve some purpose, some value at some point. And coming to a deeper and broader understanding of that full sweep of human history and human evolution and intertwining threads of our genes and our experiences as the human family. This is a perspective that we can share and help people understand each other, people who are suffering, and don’t have the words to convey what’s going on. There actually is a big picture that brings it all into relief and my hope is that we can increase empathy and understanding.&nbsp;</p>\n         <p>AS:&nbsp;That’s important and beautifully put. Thank you very much indeed. Lovely speaking with you.&nbsp;</p>\n         <p>KD:&nbsp;Great to talk to you, Adam. Take care. Bye. &nbsp;</p>\n         <p>AS:&nbsp;Bye.&nbsp;</p>\n         <!--eri-no-index-->\n         <p class=\"smalltext\">Did you find any typos in this text? We would appreciate your assistance in identifying any errors and to let us know. Thank you for taking the time to report the errors by sending us an <a href=\"https://www.nobelprize.org/contact/\">e-mail</a>.</p>\n         <!--/eri-no-index-->\n        </div>\n       </div>\n      </div>\n      <footer class=\"pagecite\" itemscope itemtype=\"http://schema.org/citation\">\n       <p class=\"pagecite__text border-top\">To cite this section\n        <br>\n        MLA style: Karl Deisseroth – Interview. NobelPrize.org. Nobel Prize Outreach 2026. Fri. 9 Oct 2026. &lt;https://www.nobelprize.org/prizes/medicine/2026/deisseroth/interview/&gt;</p>\n      </footer>\n      <div class=\"back-to-top\">\n       <a href=\"#content\" class=\"back-top-link\"> Go to the top of the page </a>\n      </div>\n     </article>\n     <!--This has been added for backwards compatibility-->\n    </section>\n    <section class=\"article-grid featured-content featured-content__color--default var-half-width-a   align  wp-block-nobel-prize-featured-content\">\n     <header class=\"section-header border-top\">\n      <h2 class=\"section-header-h3\">Six days, six prizes</h2>\n     </header>\n     <article class=\"article -halfwidth-a \">\n      <div class=\"content-wrapper\">\n       <header class=\"content\">\n        <div class=\"title\">\n         <h3 class=\"headline\"><a href=\"https://www.nobelprize.org/\"> \n           <p>Nobel Prize announcements 2026</p> \n          </a></h3>\n        </div>\n       </header>\n       <div class=\"text\">\n        <p>Don't miss the Nobel Prize announcements on 5–12 October. All announcements are streamed live here on nobelprize.org.</p>\n       </div>