ds-shadow-border-small)] @max-md:[&amp;_code]:whitespace-pre-wrap @max-md:[&amp;_code]:break-words [&amp;_a:hover_code]:text-(--geist-link-color)\">Cache status<!-- --></p>\n          </td>\n          <td>\n           <p class=\"text-copy-16 w-full [&amp;_b]:font-semibold [&amp;_code]:m-0 [&amp;_code]:rounded-md [&amp;_code]:bg-background-100 [&amp;_code]:bg-clip-padding [&amp;_code]:px-[5px] [&amp;_code]:py-1 [&amp;_code]:font-mono [&amp;_code]:text-copy-14 [&amp;_code]:font-medium [&amp;_code]:text-gray-1000 [&amp;_code]:break-normal [&amp;_code]:whitespace-nowrap [&amp;_code]:shadow-[var(--ds-shadow-border-small)] @max-md:[&amp;_code]:whitespace-pre-wrap @max-md:[&amp;_code]:break-words [&amp;_a:hover_code]:text-(--geist-link-color)\">Possible reasons</p>\n          </td>\n         </tr>\n         <tr>\n          <td>\n           <p class=\"text-copy-16 w-full [&amp;_b]:font-semibold [&amp;_code]:m-0 [&amp;_code]:rounded-md [&amp;_code]:bg-background-100 [&amp;_code]:bg-clip-padding [&amp;_code]:px-[5px] [&amp;_code]:py-1 [&amp;_code]:font-mono [&amp;_code]:text-copy-14 [&amp;_code]:font-medium [&amp;_code]:text-gray-1000 [&amp;_code]:break-normal [&amp;_code]:whitespace-nowrap [&amp;_code]:shadow-[var(--ds-shadow-border-small)] @max-md:[&amp;_code]:whitespace-pre-wrap @max-md:[&amp;_code]:break-words [&amp;_a:hover_code]:text-(--geist-link-color)\">MISS</p>\n          </td>\n          <td>\n           <p class=\"text-copy-16 w-full [&amp;_b]:font-semibold [&amp;_code]:m-0 [&amp;_code]:rounded-md [&amp;_code]:bg-background-100 [&amp;_code]:bg-clip-padding [&amp;_code]:px-[5px] [&amp;_code]:py-1 [&amp;_code]:font-mono [&amp;_code]:text-copy-14 [&amp;_code]:font-medium [&amp;_code]:text-gray-1000 [&amp;_code]:break-normal [&amp;_code]:whitespace-nowrap [&amp;_code]:shadow-[var(--ds-shadow-border-small)] @max-md:[&amp;_code]:whitespace-pre-wrap @max-md:[&amp;_code]:break-words [&amp;_a:hover_code]:text-(--geist-link-color)\">Cold, Request collapsed, Error</p>\n          </td>\n         </tr>\n         <tr>\n          <td>\n           <p class=\"text-copy-16 w-full [&amp;_b]:font-semibold [&amp;_code]:m-0 [&amp;_code]:rounded-md [&amp;_code]:bg-background-100 [&amp;_code]:bg-clip-padding [&amp;_code]:px-[5px] [&amp;_code]:py-1 [&amp;_code]:font-mono [&amp;_code]:text-copy-14 [&amp;_code]:font-medium [&amp;_code]:text-gray-1000 [&amp;_code]:break-normal [&amp;_code]:whitespace-nowrap [&amp;_code]:shadow-[var(--ds-shadow-border-small)] @max-md:[&amp;_code]:whitespace-pre-wrap @max-md:[&amp;_code]:break-words [&amp;_a:hover_code]:text-(--geist-link-color)\">BYPASS</p>\n          </td>\n          <td>\n           <p class=\"text-copy-16 w-full [&amp;_b]:font-semibold [&amp;_code]:m-0 [&amp;_code]:rounded-md [&amp;_code]:bg-background-100 [&amp;_code]:bg-clip-padding [&amp;_code]:px-[5px] [&amp;_code]:py-1 [&amp;_code]:font-mono [&amp;_code]:text-copy-14 [&amp;_code]:font-medium [&amp;_code]:text-gray-1000 [&amp;_code]:break-normal [&amp;_code]:whitespace-nowrap [&amp;_code]:shadow-[var(--ds-shadow-border-small)] @max-md:[&amp;_code]:whitespace-pre-wrap @max-md:[&amp;_code]:break-words [&amp;_a:hover_code]:text-(--geist-link-color)\">Draft Mode, Prerender Bypass, Crawler</p>\n          </td>\n         </tr>\n         <tr>\n          <td>\n           <p class=\"text-copy-16 w-full [&amp;_b]:font-semibold [&amp;_code]:m-0 [&amp;_code]:rounded-md [&amp;_code]:bg-background-100 [&amp;_code]:bg-clip-padding [&amp;_code]:px-[5px] [&amp;_code]:py-1 [&amp;_code]:font-mono [&amp;_code]:text-copy-14 [&amp;_code]:font-medium [&amp;_code]:text-gray-1000 [&amp;_code]:break-normal [&amp;_code]:whitespace-nowrap [&amp;_code]:shadow-[var(--ds-shadow-border-small)] @max-md:[&amp;_code]:whitespace-pre-wrap @max-md:[&amp;_code]:break-words [&amp;_a:hover_code]:text-(--geist-link-color)\">STALE</p>\n          </td>\n          <td>\n           <p class=\"text-copy-16 w-full [&amp;_b]:font-semibold [&amp;_code]:m-0 [&amp;_code]:rounded-md [&amp;_code]:bg-background-100 [&amp;_code]:bg-clip-padding [&amp;_code]:px-[5px] [&amp;_code]:py-1 [&amp;_code]:font-mono [&amp;_code]:text-copy-14 [&amp;_code]:font-medium [&amp;_code]:text-gray-1000 [&amp;_code]:break-normal [&amp;_code]:whitespace-nowrap [&amp;_code]:shadow-[var(--ds-shadow-border-small)] @max-md:[&amp;_code]:whitespace-pre-wrap @max-md:[&amp;_code]:break-words [&amp;_a:hover_code]:text-(--geist-link-color)\">Time-based revalidation, Tag-based invalidation, Revalidation error</p>\n          </td>\n         </tr>\n         <tr>\n          <td>\n           <p class=\"text-copy-16 w-full [&amp;_b]:font-semibold [&amp;_code]:m-0 [&amp;_code]:rounded-md [&amp;_code]:bg-background-100 [&amp;_code]:bg-clip-padding [&amp;_code]:px-[5px] [&amp;_code]:py-1 [&amp;_code]:font-mono [&amp;_code]:text-copy-14 [&amp;_code]:font-medium [&amp;_code]:text-gray-1000 [&amp;_code]:break-normal [&amp;_code]:whitespace-nowrap [&amp;_code]:shadow-[var(--ds-shadow-border-small)] @max-md:[&amp;_code]:whitespace-pre-wrap @max-md:[&amp;_code]:break-words [&amp;_a:hover_code]:text-(--geist-link-color)\">REVALIDATED</p>\n          </td>\n          <td>\n           <p class=\"text-copy-16 w-full [&amp;_b]:font-semibold [&amp;_code]:m-0 [&amp;_code]:rounded-md [&amp;_code]:bg-background-100 [&amp;_code]:bg-clip-padding [&amp;_code]:px-[5px] [&amp;_code]:py-1 [&amp;_code]:font-mono [&amp;_code]:text-copy-14 [&amp;_code]:font-medium [&amp;_code]:text-gray-1000 [&amp;_code]:break-normal [&amp;_code]:whitespace-nowrap [&amp;_code]:shadow-[var(--ds-shadow-border-small)] @max-md:[&amp;_code]:whitespace-pre-wrap @max-md:[&amp;_code]:break-words [&amp;_a:hover_code]:text-(--geist-link-color)\">Tag-based deletion</p>\n          </td>\n         </tr>\n        </tbody>\n       </table>\n      </div>\n     </div>\n    </div>\n    <p class=\"text-copy-16 w-full [&amp;_b]:font-semibold [&amp;_code]:m-0 [&amp;_code]:rounded-md [&amp;_code]:bg-background-100 [&amp;_code]:bg-clip-padding [&amp;_code]:px-[5px] [&amp;_code]:py-1 [&amp;_code]:font-mono [&amp;_code]:text-copy-14 [&amp;_code]:font-medium [&amp;_code]:text-gray-1000 [&amp;_code]:break-normal [&amp;_code]:whitespace-nowrap [&amp;_code]:shadow-[var(--ds-shadow-border-small)] @max-md:[&amp;_code]:whitespace-pre-wrap @max-md:[&amp;_code]:break-words [&amp;_a:hover_code]:text-(--geist-link-color)\">Open the Logs tab and select a request to see the reason alongside its cache status. Each status and reason links to its entry in the <a href=\"https://vercel.com/docs/caching/cache-status\" rel=\"noopener\" target=\"_self\" data-track=\"true\" data-track-click-name=\"article_link\" data-track-click-value=\"https://vercel.com/docs/caching/cache-status\" data-zone=\"null\" class=\"cursor-pointer focus-visible:outline-2 outline-[var(--ds-focus-color)] outline-offset-4 text-[var(--geist-link-color)] [:not([aria-disabled])]:hover:underline [&amp;_u]:no-underline underline decoration-1 underline-offset-2 text-inherit! hover:decoration-1! hover:text-(--geist-link-color)! focus-visible:outline-offset-2\">Cache Status and Reasons</a> reference.</p>\n    <div class=\"flex! flex-col! items-center! justify-center! gap-4! max-w-none! not-frist:mt-20! not-first:mb-10! mx-0! max-[600px]:max-w-none! max-[600px]:px-7! max-[600px]:in-[li]:pr-14! max-[600px]:in-[li]:pl-0! max-[600px]:w-full! max-[600px]:mt-12! max-[600px]:mb-6!\">\n     <div class=\"rounded-md! p-2! bg-background-100! shadow-[var(--ds-shadow-border-small)]! bg-clip-padding! grid! max-w-[900px]! sm:border-l-0! sm:border-r-0! sm:border-(--guide-color)! sm:w-full!\">\n      <img data-version=\"v1\" alt=\"A STALE request with a Time-based revalidation reason in runtime logs.\" loading=\"lazy\" decoding=\"async\" data-nimg=\"1\" class=\"[.dark-theme_&amp;]:hidden! h-auto max-w-full\" style=\"color:transparent\" srcset=\"https://assets.vercel.com/image/upload/contentful/image/e5382hct74si/4hFlhWg3wzMwquJmxvc4x1/30da221c0f8b823bd1d7fd99fdfa5769/image__13_.png 1x, https://assets.vercel.com/image/upload/contentful/image/e5382hct74si/4hFlhWg3wzMwquJmxvc4x1/30da221c0f8b823bd1d7fd99fdfa5769/image__13_.png 2x\" src=\"https://assets.vercel.com/image/upload/contentful/image/e5382hct74si/4hFlhWg3wzMwquJmxvc4x1/30da221c0f8b823bd1d7fd99fdfa5769/image__13_.png\"><img data-version=\"v1\" alt=\"A STALE request with a Time-based revalidation reason in runtime logs.\" loading=\"lazy\" decoding=\"async\" data-nimg=\"1\" class=\"[.light-theme_&amp;]:hidden! h-auto max-w-full\" style=\"color:transparent\" srcset=\"https://assets.vercel.com/image/upload/contentful/image/e5382hct74si/aNDlmWtFHJKWNxsiGEY59/703d006f8b48773f4c117691d10bfaac/image__14_.png 1x, https://assets.vercel.com/image/upload/contentful/image/e5382hct74si/aNDlmWtFHJKWNxsiGEY59/703d006f8b48773f4c117691d10bfaac/image__14_.png 2x\" src=\"https://assets.vercel.com/image/upload/contentful/image/e5382hct74si/aNDlmWtFHJKWNxsiGEY59/703d006f8b48773f4c117691d10bfaac/image__14_.png\">\n     </div>\n     <figcaption class=\"text-copy-14 text-gray-900 text-center m-auto max-w-(--article-max-width) max-[600px]:px-0 max-[600px]:py-4\">A STALE request with a Time-based revalidation reason in runtime logs.</figcaption>\n    </div>\n    <h3 class=\"text-heading-24 font-normal! leading-[1.1]! pt-10 [&amp;:has(_b)]:text-gray-900 [&amp;_b]:text-gray-1000 [&amp;_b]:font-normal w-full group relative text-balance\"><a class=\"flex items-center justify-center flex-col absolute left-0 bottom-0 mt-auto mb-auto w-8 h-8 rounded-full opacity-0 group-hover:opacity-100 -translate-x-3/4 group-hover:-translate-x-full delay-75 duration-300 transition-all text-gray-900 hover:text-gray-1000 hover:scale-110 focus-visible:-translate-x-full focus-visible:opacity-100 top-8 in-[#changelog-description]:hidden\" href=\"#from-the-cli\" id=\"from-the-cli\" style=\"scroll-margin-top:90px\"> \n      <svg viewBox=\"0 0 16 16\" height=\"12\" width=\"12\" data-slot=\"geist-icon\" style=\"color:currentColor\">\n       <path fill=\"currentColor\" fill-rule=\"evenodd\" d=\"M8.47 1.47a4.29 4.29 0 1 1 6.06 6.06l-2.5 2.5-1.06-1.06 2.5-2.5a2.79 2.79 0 0 0-3.94-3.94l-2.5 2.5-1.06-1.06zm3.06 4.06-6 6-1.06-1.06 6-6zm-10.06 9a4.3 4.3 0 0 0 6.06 0l2.5-2.5-1.06-1.06-2.5 2.5a2.79 2.79 0 0 1-3.94-3.94l2.5-2.5-1.06-1.06-2.5 2.5a4.3 4.3 0 0 0 0 6.06\" clip-rule=\"evenodd\"></path>\n      </svg> \n      <span class=\"sr-only\">Copy link to heading</span> \n     </a>From the CLI</h3>\n    <p class=\"text-copy-16 w-full [&amp;_b]:font-semibold [&amp;_code]:m-0 [&amp;_code]:rounded-md [&amp;_code]:bg-background-100 [&amp;_code]:bg-clip-padding [&amp;_code]:px-[5px] [&amp;_code]:py-1 [&amp;_code]:font-mono [&amp;_code]:text-copy-14 [&amp;_code]:font-medium [&amp;_code]:text-gray-1000 [&amp;_code]:break-normal [&amp;_code]:whitespace-nowrap [&amp;_code]:shadow-[var(--ds-shadow-border-small)] @max-md:[&amp;_code]:whitespace-pre-wrap @max-md:[&amp;_code]:break-words [&amp;_a:hover_code]:text-(--geist-link-color)\">Cache reason is available in <code>vercel logs</code>, <code>vercel metrics</code>, and Vercel plugin's <a href=\"https://www.skills.sh/vercel/vercel-plugin/cdn-caching\" rel=\"noopener\" target=\"_blank\" data-track=\"true\" data-track-click-name=\"article_link\" data-track-click-value=\"https://www.skills.sh/vercel/vercel-plugin/cdn-caching\" data-zone=\"null\" class=\"cursor-pointer focus-visible:outline-2 outline-[var(--ds-focus-color)] outline-offset-4 text-[var(--geist-link-color)] [:not([aria-disabled])]:hover:underline [&amp;_u]:no-underline underline decoration-1 underline-offset-2 text-inherit! hover:decoration-1! hover:text-(--geist-link-color)! focus-visible:outline-offset-2\">cdn-caching skill</a>:</p>\n    <div class=\"flex flex-col items-stretch justify-start gap-4 flex-initial blog-code-block-module__TEKDOa__wrapper\">\n     <div class=\"relative my-4 rounded-md border border-[var(--ds-gray-400)] overflow-hidden group/copy blog-code-block-module__TEKDOa__codeBlock\" data-geist-code-block=\"\">\n     