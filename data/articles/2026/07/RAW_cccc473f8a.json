hide-when-no-script\" aria-label=\"image unavailable\"><img sizes=\"(min-width: 1280px) 50vw, (min-width: 1008px) 66vw, 96vw\" srcset=\"https://ichef.bbci.co.uk/news/240/cpsprodpb/fc8b/live/16395500-8132-11f1-b525-63787292c170.jpg.webp 240w, https://ichef.bbci.co.uk/news/320/cpsprodpb/fc8b/live/16395500-8132-11f1-b525-63787292c170.jpg.webp 320w, https://ichef.bbci.co.uk/news/480/cpsprodpb/fc8b/live/16395500-8132-11f1-b525-63787292c170.jpg.webp 480w, https://ichef.bbci.co.uk/news/640/cpsprodpb/fc8b/live/16395500-8132-11f1-b525-63787292c170.jpg.webp 640w, https://ichef.bbci.co.uk/news/800/cpsprodpb/fc8b/live/16395500-8132-11f1-b525-63787292c170.jpg.webp 800w, https://ichef.bbci.co.uk/news/1024/cpsprodpb/fc8b/live/16395500-8132-11f1-b525-63787292c170.jpg.webp 1024w, https://ichef.bbci.co.uk/news/1536/cpsprodpb/fc8b/live/16395500-8132-11f1-b525-63787292c170.jpg.webp 1536w\" src=\"https://ichef.bbci.co.uk/news/480/cpsprodpb/fc8b/live/16395500-8132-11f1-b525-63787292c170.jpg.webp\" loading=\"eager\" alt=\"Supplied A woman with glasses and a hat posing next to a bunch of bananas\" class=\"Image-styles__ImageStyled-sc-8c99a12b-0 cVsHni\"><span class=\"Image-styles__CreditStyled-sc-8c99a12b-2 dVFjVB\">Supplied</span>\n      </div>\n     </div>\n     <div class=\"GridItem-styles__GridItemStyled-sc-6cc20e4a-0 tlbDj\">\n      <figcaption class=\"Caption-styles__CaptionStyled-sc-70433723-0 fLsOPx\">Emma (pictured) and Peter Stav waited 15 years for their plants to suddenly grow fruit</figcaption>\n     </div>\n    </figure>\n   </div>\n  </div>\n  <div>\n   <div data-component=\"text-block\" class=\"Container-styles__ContainerStyled-sc-8b855a6c-0 cPmzSx\">\n    <div class=\"hRsXiV\">\n     <div class=\"GridItem-styles__GridItemStyled-sc-6cc20e4a-0 bnCeGm\">\n      <p class=\"Paragraph-styles__ParagraphStyled-sc-ffb5f5ba-0 fqhmpl\">Could bananas be common in British gardens soon? Warmer summers and milder winters might mean new fruits appearing, while we say goodbye to some old favourites.</p>\n     </div>\n    </div>\n   </div>\n  </div>\n  <div>\n   <div data-component=\"text-block\" class=\"Container-styles__ContainerStyled-sc-8b855a6c-0 cPmzSx\">\n    <div class=\"hRsXiV\">\n     <div class=\"GridItem-styles__GridItemStyled-sc-6cc20e4a-0 bnCeGm\">\n      <p class=\"Paragraph-styles__ParagraphStyled-sc-ffb5f5ba-0 fqhmpl\">Peter and Emma Stav, tropical plant enthusiasts from Rayleigh in Essex, were astonished to see fruit finally grow on their collection of 200 banana plants after 15 years.</p>\n     </div>\n    </div>\n   </div>\n  </div>\n  <div>\n   <div data-component=\"text-block\" class=\"Container-styles__ContainerStyled-sc-8b855a6c-0 cPmzSx\">\n    <div class=\"hRsXiV\">\n     <div class=\"GridItem-styles__GridItemStyled-sc-6cc20e4a-0 bnCeGm\">\n      <p class=\"Paragraph-styles__ParagraphStyled-sc-ffb5f5ba-0 fqhmpl\">Peter, a 38-year-old school teacher, said: \"I'm just absolutely amazed that it's happened.\"</p>\n     </div>\n    </div>\n   </div>\n  </div>\n  <div>\n   <div data-component=\"text-block\" class=\"Container-styles__ContainerStyled-sc-8b855a6c-0 cPmzSx\">\n    <div class=\"hRsXiV\">\n     <div class=\"GridItem-styles__GridItemStyled-sc-6cc20e4a-0 bnCeGm\">\n      <p class=\"Paragraph-styles__ParagraphStyled-sc-ffb5f5ba-0 fqhmpl\">Guy Barter from The Royal Horticultural Society said \"heat-loving plants\" such as olives, figs and apricots are excelling more, while traditional British crops like gooseberries and rhubarb are on the decline in some areas.</p>\n     </div>\n    </div>\n   </div>\n  </div>\n  <div>\n   <div data-component=\"text-block\" class=\"Container-styles__ContainerStyled-sc-8b855a6c-0 cPmzSx\">\n    <div class=\"hRsXiV\">\n     <div class=\"GridItem-styles__GridItemStyled-sc-6cc20e4a-0 bnCeGm\">\n      <p class=\"Paragraph-styles__ParagraphStyled-sc-ffb5f5ba-0 fqhmpl\">The chief horticulturist said: \"The climate is getting warmer and bananas never used to flower 20 years ago. It would be a red letter day when the banana flowers.\"</p>\n     </div>\n    </div>\n   </div>\n  </div>\n  <div>\n   <div data-component=\"image-block\" class=\"Container-styles__ContainerStyled-sc-8b855a6c-0 kugUwP\">\n    <figure class=\"ieGDnl\">\n     <div class=\"GridItem-styles__GridItemStyled-sc-6cc20e4a-0 tlbDj\">\n      <div data-testid=\"image\" class=\"Image-styles__ImageCardStyled-sc-8c99a12b-1 bOmCce\">\n       <img src=\"https://static.files.bbci.co.uk/bbcdotcom/web/20260714-093448-684066af18-web-3.14.0-3/grey-placeholder.png\" class=\"Image-styles__ImageStyled-sc-8c99a12b-0 kpUtIW hide-when-no-script\" aria-label=\"image unavailable\"><img sizes=\"(min-width: 1280px) 50vw, (min-width: 1008px) 66vw, 96vw\" srcset=\"https://ichef.bbci.co.uk/news/240/cpsprodpb/92a4/live/f95a2000-8333-11f1-829d-29134f2a54ad.jpg.webp 240w, https://ichef.bbci.co.uk/news/320/cpsprodpb/92a4/live/f95a2000-8333-11f1-829d-29134f2a54ad.jpg.webp 320w, https://ichef.bbci.co.uk/news/480/cpsprodpb/92a4/live/f95a2000-8333-11f1-829d-29134f2a54ad.jpg.webp 480w, https://ichef.bbci.co.uk/news/640/cpsprodpb/92a4/live/f95a2000-8333-11f1-829d-29134f2a54ad.jpg.webp 640w, https://ichef.bbci.co.uk/news/800/cpsprodpb/92a4/live/f95a2000-8333-11f1-829d-29134f2a54ad.jpg.webp 800w, https://ichef.bbci.co.uk/news/1024/cpsprodpb/92a4/live/f95a2000-8333-11f1-829d-29134f2a54ad.jpg.webp 1024w, https://ichef.bbci.co.uk/news/1536/cpsprodpb/92a4/live/f95a2000-8333-11f1-829d-29134f2a54ad.jpg.webp 1536w\" src=\"https://ichef.bbci.co.uk/news/480/cpsprodpb/92a4/live/f95a2000-8333-11f1-829d-29134f2a54ad.jpg.webp\" loading=\"lazy\" alt=\"Peter Stav A close up of a thick green stalk which is splitting off into fruit that slightly resembles bananas\" class=\"Image-styles__ImageStyled-sc-8c99a12b-0 cVsHni\"><span class=\"Image-styles__CreditStyled-sc-8c99a12b-2 dVFjVB\">Peter Stav</span>\n      </div>\n     </div>\n     <div class=\"GridItem-styles__GridItemStyled-sc-6cc20e4a-0 tlbDj\">\n      <figcaption class=\"Caption-styles__CaptionStyled-sc-70433723-0 fLsOPx\">Olives and apricots are thriving, while gooseberries and rhubarb struggle</figcaption>\n     </div>\n    </figure>\n   </div>\n  </div>\n  <div>\n   <div data-component=\"text-block\" class=\"Container-styles__ContainerStyled-sc-8b855a6c-0 cPmzSx\">\n    <div class=\"hRsXiV\">\n     <div class=\"GridItem-styles__GridItemStyled-sc-6cc20e4a-0 bnCeGm\">\n      <p class=\"Paragraph-styles__ParagraphStyled-sc-ffb5f5ba-0 fqhmpl\">The Musa Basjoo banana has always been famous for being able to survive UK winters, but the flower often needs protection from frost.</p>\n     </div>\n    </div>\n   </div>\n  </div>\n  <div>\n   <div data-component=\"text-block\" class=\"Container-styles__ContainerStyled-sc-8b855a6c-0 cPmzSx\">\n    <div class=\"hRsXiV\">\n     <div class=\"GridItem-styles__GridItemStyled-sc-6cc20e4a-0 bnCeGm\">\n      <p class=\"Paragraph-styles__ParagraphStyled-sc-ffb5f5ba-0 fqhmpl\">The Stavs have built walls around their plants to trap heat and create a \"microclimate effect\" for the colder winter weather.</p>\n     </div>\n    </div>\n   </div>\n  </div>\n  <div>\n   <div data-component=\"text-block\" class=\"Container-styles__ContainerStyled-sc-8b855a6c-0 cPmzSx\">\n    <div class=\"hRsXiV\">\n     <div class=\"GridItem-styles__GridItemStyled-sc-6cc20e4a-0 bnCeGm\">\n      <p class=\"Paragraph-styles__ParagraphStyled-sc-ffb5f5ba-0 fqhmpl\">Peter said: \"Over the past couple of winters I haven't wrapped them up because they're nearly 3m (10ft) tall so it's very difficult to wrap them. This year due to the heatwave, the plant's actually fruited.</p>\n     </div>\n    </div>\n   </div>\n  </div>\n  <div>\n   <div data-component=\"text-block\" class=\"Container-styles__ContainerStyled-sc-8b855a6c-0 cPmzSx\">\n    <div class=\"hRsXiV\">\n     <div class=\"GridItem-styles__GridItemStyled-sc-6cc20e4a-0 bnCeGm\">\n      <p class=\"Paragraph-styles__ParagraphStyled-sc-ffb5f5ba-0 fqhmpl\">\"You put one in the ground and you get another 10 come up. They split. They produce more and more and more.\"</p>\n     </div>\n    </div>\n   </div>\n  </div>\n  <div>\n   <div data-component=\"text-block\" class=\"Container-styles__ContainerStyled-sc-8b855a6c-0 cPmzSx\">\n    <div class=\"hRsXiV\">\n     <div class=\"GridItem-styles__GridItemStyled-sc-6cc20e4a-0 bnCeGm\">\n      <p class=\"Paragraph-styles__ParagraphStyled-sc-ffb5f5ba-0 fqhmpl\">Elsewhere in the East of England, a 76-year-old <a target=\"_self\" href=\"https://www.bbc.co.uk/news/articles/cp8r86k3np0o\" class=\"LinkUrl-styles__LinkUrlStyled-sc-f4e3b82f-0 eGAhOs\">man from Suffolk was in \"complete surprise\"</a> when his banana plant suddenly produced fruit for the first time.</p>\n     </div>\n    </div>\n   </div>\n  </div>\n  <div>\n   <div data-component=\"text-block\" class=\"Container-styles__ContainerStyled-sc-8b855a6c-0 cPmzSx\">\n    <div class=\"hRsXiV\">\n     <div class=\"GridItem-styles__GridItemStyled-sc-6cc20e4a-0 bnCeGm\">\n      <p class=\"Paragraph-styles__ParagraphStyled-sc-ffb5f5ba-0 fqhmpl\">Stephen Hind, of Pettistree near Wickham Market, bought the tree for his exotic garden a few years ago because \"they just look good\", and believes scorching temperatures played a part in bringing it to life.</p>\n     </div>\n    </div>\n   </div>\n  </div>\n  <div>\n   <div data-component=\"image-block\" class=\"Container-styles__ContainerStyled-sc-8b855a6c-0 kugUwP\">\n    <figure class=\"ieGDnl\">\n     <div class=\"GridItem-styles__GridItemStyled-sc-6cc20e4a-0 tlbDj\">\n      <div data-testid=\"image\" class=\"Image-styles__ImageCardStyled-sc-8c99a12b-1 bOmCce\">\n       <img src=\"https://static.files.bbci.co.uk/bbcdotcom/web/20260714-093448-684066af18-web-3.14.0-3/grey-placeholder.png\" class=\"Image-styles__ImageStyled-sc-8c99a12b-0 kpUtIW hide-when-no-script\" aria-label=\"image unavailable\"><img sizes=\"(min-width: 1280px) 50vw, (min-width: 1008px) 66vw, 96vw\" srcset=\"https://ichef.bbci.co.uk/news/240/cpsprodpb/8500/live/cee47220-8046-11f1-8a74-43d9da26a654.jpg.webp 240w, https://ichef.bbci.co.uk/news/320/cpsprodpb/8500/live/cee47220-8046-11f1-8a74-43d9da26a654.jpg.webp 320w, https://ichef.bbci.co.uk/news/480/cpsprodpb/8500/live/cee47220-8046-11f1-8a74-43d9da26a654.jpg.webp 480w, https://ichef.bbci.co.uk/news/640/cpsprodpb/8500/live/cee47220-8046-11f1-8a74-43d9da26a654.jpg.webp 640w, https://ichef.bbci.co.uk/news/800/cpsprodpb/8500/live/cee47220-8046-11f1-8a74-43d9da26a654.jpg.webp 800w, https://ichef.bbci.co.uk/news/1024/cpsprodpb/8500/live/cee47220-8046-11f1-8a74-43d9da26a654.jpg.webp 1024w, https://ichef.bbci.co.uk/news/1536/cpsprodpb/8500/live/cee47220-8046-11f1-8a74-43d9da26a654.jpg.webp 1536w\" src=\"https://ichef.bbci.co.uk/news/480/cpsprodpb/8500/live/cee47220-8046-11f1-8a74-43d9da26a654.jpg.webp\" loading=\"lazy\" alt=\"Supplied A man wearing glasses, a dark blue T-shirt and light blue shorts stands next to a banana plant. There are a number of trees and plants behind him.\" class=\"Image-styles__ImageStyled-sc-8c99a12b-0 cVsHni\"><span class=\"Image-styles__CreditStyled-sc-8c99a12b-2 dVFjVB\">Supplied</span>\n      </div>\n     </div>\n     <div class=\"GridItem-styles__GridItemStyled-sc-6cc20e4a-0 tlbDj\">\n      <figcaption class=\"Caption-styles__CaptionStyled-sc-70433723-0 fLsOPx\">Stephen Hind takes pride in maintaining his garden, which is filled with exotic plants and trees</figcaption>\n     </div>\n    </figure>\n   </div>\n  </div>\n  <div>\n   <div data-component=\"text-block\" class=\"Container-styles__ContainerStyled-sc-8b855a6c-0 cPmzSx\">\n    <div class=\"hRsXiV\">\n     <div class=\"GridItem-styles__GridItemStyled-sc-6cc20e4a-0 bnCeGm\">\n      <p class=\"Paragraph-styles__ParagraphStyled-sc-ffb5f5ba-0 fqhmpl\">TV presenter and botanist James Wong said the hotter UK temperatures has made it \"very easy\" to grow bananas.</p>\n     </div>\n    </div>\n   </div>\n  </div>\n  <div>\n   <div data-component=\"text-block\" class=\"Container-styles__ContainerStyled-sc-8b855a6c-0 cPmzSx\">\n    <div class=\"hRsXiV\">\n     <div class=\"GridItem-styles__GridItemStyled-sc-6cc20e4a-0 bnCeGm\">\n      <p class=\"Paragraph-styles__ParagraphStyled-sc-ffb5f5ba-0 fqhmpl\">He said: \"It's sort of impossible to water or fertilise them too much. They're incredibly fast growing if they have that heat.</p>\n     </div>\n    </div>\n   </div>\n  </div>\n  <div>\n   <div data-component=\"text-block\" class=\"Container-styles__ContainerStyled-sc-8b855a6c-0 cPmzSx\">\n    <div class=\"hRsXiV\">\n     <div class=\"GridItem-styles__GridItemStyled-sc-6cc20e4a-0 bnCeGm\">\n      <p class=\"Paragraph-styles__ParagraphStyled-sc-ffb5f5ba-0 fqhmpl\">\"If people live in a really cold or exposed area or in the northern half of Britain, they might wrap up the stems.</p>\n     </div>\n    </div>\n   </div>\n  </div>\n  <div>\n   <div data-component=\"text-block\" class=\"Container-styles__ContainerStyled-sc-8b855a6c-0 cPmzSx\">\n    <div class=\"hRsXiV\">\n     <div class=\"GridItem-styles__GridItemStyled-sc-6cc20e4a-0 bnCeGm\">\n      <p class=\"Paragraph-styles__ParagraphStyled-sc-ffb5f5ba-0 fqhmpl\">\"That basically creates like an insulating layer that protects a pocket of warm air around the plants and stops frost from damaging their cells.\"</p>\n     </div>\n    </div>\n   </div>\n  </div>\n  <div>\n   <div data-component=\"subheadline-block\" class=\"Container-styles__ContainerStyled-sc-8b855a6c-0 fMCMex\">\n    <div class=\"hRsXiV\">\n     <div class=\"GridItem-styles__GridItemStyled-sc-6cc20e4a-0 tlbDj\">\n      <h2 class=\"Headline-styles__HeadlineStyled-sc-6b3bb442-0 knYLIy\">'Mouthful of ball bearings'</h2>\n     </div>\n    </div>\n   </div>\n  </div>\n  <div>\n   <div data-component=\"image-block\" class=\"Container-styles__ContainerStyled-sc-8b855a6c-0 kugUwP\">\n    <figure class=\"ieGDnl\">\n     <div class=\"GridItem-styles__GridItemStyled-sc-6cc20e4a-0 tlbDj\">\n      <div data-testid=\"image\" class=\"Image-styles__ImageCardStyled-sc-8c99a12b-1 bOmCce\">\n       <img src=\"https://static.files.bbci.co.uk/bbcdotcom/web/20260714-093448-684066af18-web-3.14.0-3/grey-placeholder.png\" class=\"Image-styles__ImageStyled-sc-8c99a12b-0 kpUtIW hide-when-no-script\" aria-label=\"image unavailable\"><img sizes=\"(min-width: 1280px) 50vw, (min-width: 1008px) 66vw, 96vw\" srcset=\"https://ichef.bbci.co.uk/news/240/cpsprodpb/2fa6/live/a0e75aa0-811c-11f1-926f-c90d1bcfbc84.jpg.webp 240w, https://ichef.bbci.co.uk/news/320/cpsprodpb/2fa6/live/a0e75aa0-811c-11f1-926f-c90d1bcfbc84.jpg.webp 320w, https://ichef.bbci.co.uk/news/480/cpsprodpb/2fa6/live/a0e75aa0-811c-11f1-926f-c90d1bcfbc84.jpg.webp 480w, https://ichef.bbci.co.uk/news/640/cpsprodpb/2fa6/live/a0e75aa0-811c-11f1-926f-c90d1bcfbc84.jpg.webp 640w, https://ichef.bbci.co.uk/news/800/cpsprodpb/2fa6/live/a0e75aa0-811c-11f1-926f-c90d1bcfbc84.jpg.webp 800w, https://ichef.bbci.co.uk/news/1024/cpsprodpb/2fa6/live/a0e75aa0-811c-11f1-926f-c90d1bcfbc84.jpg.webp 1024w, https://ichef.bbci.co.uk/news/1536/cpsprodpb/2fa6/live/a0e75aa0-811c-11f1-926f-c90d1bcfbc84.jpg.webp 1536w\" src=\"https://ichef.bbci.co.uk/news/480/cpsprodpb/2fa6/live/a0e75aa0-811c-11f1-926f-c90d1bcfbc84.jpg.webp\" loading=\"lazy\" alt=\"BBC Studios James Wong looking closely at a plant \" class=\"Image-styles__ImageStyled-sc-8c99a12b-0 cVsHni\"><span class=\"Image-styles__CreditStyled-sc-8c99a12b-2 dVFjVB\">BBC Studios</span>\n      </div>\n     </div>\n     <div class=\"GridItem-styles__GridItemStyled-sc-6cc20e4a-0 tlbDj\">\n      <figcaption class=\"Caption-styles__CaptionStyled-sc-70433723-0 fLsOPx\">Botanist James Wong has appeared on the BBC's A Countryside Summer</figcaption>\n     </div>\n    </figure>\n   </div>\n  </div>\n  <div>\n   <div data-component=\"text-block\" class=\"Container-styles__ContainerStyled-sc-8b855a6c-0 cPmzSx\">\n    <div class=\"hRsXiV\">\n     <div class=\"GridItem-styles__GridItemStyled-sc-6cc20e4a-0 bnCeGm\">\n      <p class=\"Paragraph-styles__ParagraphStyled-sc-ffb5f5ba-0 fqhmpl\">Wong, 45, has presented for BBC series' Grow Your Own Drugs and Secrets of Your Food.</p>\n     </div>\n    </div>\n   </div>\n  </div>\n  <div>\n   <div data-component=\"text-block\" class=\"Container-styles__ContainerStyled-sc-8b855a6c-0 cPmzSx\">\n    <div class=\"hRsXiV\">\n     <div class=\"GridItem-styles__GridItemStyled-sc-6cc20e4a-0 bnCeGm\">\n      <p class=\"Paragraph-styles__ParagraphStyled-sc-ffb5f5ba-0 fqhmpl\">He pointed out that Musa Basjoos are not really for eating.</p>\n     </div>\n    </div>\n   </div>\n  </div>\n  <div>\n   <div data-component=\"text-block\" class=\"Container-styles__ContainerStyled-sc-8b855a6c-0 cPmzSx\">\n    <div class=\"hRsXiV\">\n     <div class=\"GridItem-styles__GridItemStyled-sc-6cc20e4a-0 bnCeGm\">\n      <p class=\"Paragraph-styles__ParagraphStyled-sc-ffb5f5ba-0 fqhmpl\">He said: \"It's basically like having a mouth full of ball bearings with half a teaspoon of banana on them.\"</p>\n     </div>\n    </div>\n   </div>\n  </div>\n  <div>\n   <div data-component=\"text-block\" class=\"Container-styles__ContainerStyled-sc-8b855a6c-0 cPmzSx\">\n    <div class=\"hRsXiV\">\n     <div class=\"GridItem-styles__GridItemStyled-sc-6cc20e4a-0 bnCeGm\">\n      <p class=\"Paragraph-styles__ParagraphStyled-sc-ffb5f5ba-0 fqhmpl\">He added that growing banana plants in the UK is not new for a \"geek in the plant world\", but perhaps still niche to the average person.</p>\n     </div>\n    </div>\n   </div>\n  </div>\n  <div>\n   <div data-component=\"text-block\" class=\"Container-styles__ContainerStyled-sc-8b855a6c-0 cPmzSx\">\n    <div class=\"hRsXiV\">\n     <div class=\"GridItem-styles__GridItemStyled-sc-6cc20e4a-0 bnCeGm\">\n      <p class=\"Paragraph-styles__ParagraphStyled-sc-ffb5f5ba-0 fqhmpl\"><b id=\"do-you-have-a-story-suggestion-for-essex?-contact-us-below.\" class=\"TextFragment-styles__TextFragmentStyled-sc-99e7c69b-0 jlzOpL\">Do you have a story suggestion for Essex? Contact us below.</b></p>\n     </div>\n    </div>\n   </div>\n  </div>\n  <div>\n   <div data-component=\"embed-block\" class=\"Container-styles__ContainerStyled-sc-8b855a6c-0 kugUwP\">\n    <div class=\"hRsXiV\"></div>\n   </div>\n  </div>\n  <div>\n   <div data-component=\"text-block\" class=\"Container-styles__ContainerStyled-sc-8b855a6c-0 cPmzSx\">\n    <div class=\"hRsXiV\">\n     <div class=\"GridItem-styles__GridItemStyled-sc-6cc20e4a-0 bnCeGm\">\n      <p class=\"Paragraph-styles__ParagraphStyled-sc-ffb5f5ba-0 fqhmpl\"><i id=\"follow-essex-news-on\" class=\"TextFragment-styles__TextFragmentStyled-sc-99e7c69b-0 kAUhPg\">Follow Essex news on </i><a target=\"_self\" href=\"https://www.bbc.co.uk/sounds/curation/p0cjdqpb\" class=\"LinkUrl-styles__LinkUrlStyled-sc-f4e3b82f-0 eGAhOs\"><i id=\"bbc-sounds\" class=\"TextFragment-styles__TextFragmentStyled-sc-99e7c69b-0 kAUhPg\">BBC Sounds</i></a><i id=\",\" class=\"TextFragment-styles__TextFragmentStyled-sc-99e7c69b-0 kAUhPg\">, </i><a target=\"_blank\" href=\"https://www.facebook.com/BBCEssex/\" class=\"LinkUrl-styles__LinkUrlStyled-sc-f4e3b82f-0 eGAhOs\"><i id=\"facebook\" class=\"TextFragment-styles__TextFragmentStyled-sc-99e7c69b-0 kAUhPg\">Facebook</i></a><i id=\",\" class=\"TextFragment-styles__TextFragmentStyled-sc-99e7c69b-0 kAUhPg\">, </i><a target=\"_blank\" href=\"https://www.instagram.com/bbcessex\" class=\"LinkUrl-styles__LinkUrlStyled-sc-f4e3b82f-0 eGAhOs\"><i id=\"instagram\" class=\"TextFragment-styles__TextFragmentStyled-sc-99e7c69b-0 kAUhPg\">Instagram</i></a><i id=\"and\" class=\"TextFragment-styles__TextFragmentStyled-sc-99e7c69b-0 kAUhPg\"> and </i><a target=\"_blank\" href=\"https://twitter.com/BBCessex\" class=\"LinkUrl-styles__LinkUrlStyled-sc-f4e3b82f-0 eGAhOs\"><i id=\"x\" class=\"TextFragment-styles__TextFragmentStyled-sc-99e7c69b-0 kAUhPg\">X</i></a><i id=\".\" class=\"TextFragment-styles__TextFragmentStyled-sc-99e7c69b-0 kAUhPg\">.</i></p>\n     </div>\n    </div>\n   </div>\n  </div>\n  <div>\n   <div data-component=\"links-block\" class=\"Container-styles__ContainerStyled-sc-8b855a6c-0 kugUwP\">\n    <div class=\"hRsXiV\">\n     <div class=\"GridItem-styles__GridItemStyled-sc-6cc20e4a-0 tlbDj\">\n      <div class=\"Links-styles__LinksContainerStyled-sc-b3f84cef-0 ewqQPE kNVPcT\">\n       <span data-testid=\"links-title\" class=\"Links-styles__LinksTitleStyled-sc-b3f84cef-2 QpkFI\">More on this story</span>\n       <div data-testid=\"links-grid\" class=\"Links-styles__LinksGridStyled-sc-b3f84cef-1 beamNM kHJKKp\">\n        <div data-testid=\"chester-card\" data-indexcard=\"true\" class=\"IndexCard-styles__IndexCardStyled-sc-3a0d8802-0 jeApUG\">\n         <div data-testid=\"anchor-inner-wrapper\">\n          <a href=\"https://www.bbc.co.uk/news/articles/cp8r86k3np0o\" data-testid=\"external-anchor\" target=\"_self\" class=\"Anchor-styles__AnchorStyled-sc-651d33db-0 hygVWX\"> \n           <div data-testid=\"chester-article\" class=\"Chester-styles__CardStyled-sc-340eb5f4-0 bdssIl\">\n            <div class=\"IndexCardHeading-styles__TitleGravityWrapper-sc-c7d910a6-1 dWFLGi\">\n             <div class=\"IndexCardHeading-styles__TitleWrapperStyled-sc-c7d910a6-0 hEhfIe\">\n              <h2 data-testid=\"card-headline\" class=\"IndexCardHeading-styles__CardHeadlineStyled-sc-c7d910a6-3 dyeGOh\">Bananas! Surprise as back garden plant bears fruit</h2>\n             </div>\n            </div>\n           </div> \n          </a>\n         </div>\n        </div>\n        <div data-testid=\"chester-card\" data-indexcard=\"true\" class=\"IndexCard-styles__IndexCardStyled-sc-3a0d8802-0 jeApUG\">\n         <div data-testid=\"anchor-inner-wrapper\">\n          <a href=\"https://www.bbc.co.uk/news/articles/czd21re2l05o\" data-testid=\"external-anchor\" target=\"_self\" class=\"Anchor-styles__AnchorStyled-sc-651d33db-0 hygVWX\"> \n           <div data-testid=\"chester-article\" class=\"Chester-styles__CardStyled-sc-340eb5f4-0 bdssIl\">\n            <div class=\"IndexCardHeading-styles__TitleGravityWra